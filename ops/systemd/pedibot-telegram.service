[Unit]
Description=PediBot Telegram bot (long polling)
After=network-online.target pedibot-api.service
Wants=network-online.target

[Service]
User=pedibot
Group=pedibot
WorkingDirectory=/opt/pedibot
EnvironmentFile=/opt/pedibot/.env
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/pedibot/.local/bin/uv run --no-dev pedibot telegram
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/pedibot

[Install]
WantedBy=multi-user.target
