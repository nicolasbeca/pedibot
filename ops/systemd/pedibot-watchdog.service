[Unit]
Description=PediBot watchdog (health, DeepSeek balance, disk, daily cost → Telegram)

[Service]
Type=oneshot
User=pedibot
WorkingDirectory=/opt/pedibot
EnvironmentFile=/opt/pedibot/.env
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/pedibot/.local/bin/uv run --no-dev python ops/watchdog.py
