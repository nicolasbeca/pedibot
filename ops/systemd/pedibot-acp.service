[Unit]
Description=PediBot ACP provider worker (answers paid jobs from other agents)
After=network-online.target pedibot-api.service
Wants=network-online.target

[Service]
User=pedibot
Group=pedibot
WorkingDirectory=/opt/pedibot
EnvironmentFile=/opt/pedibot/.env
Environment=PYTHONIOENCODING=utf-8
Environment=HOME=/opt/pedibot
ExecStart=/opt/pedibot/.local/bin/uv run --no-dev python ops/acp_worker.py
Restart=always
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/pedibot

[Install]
WantedBy=multi-user.target
