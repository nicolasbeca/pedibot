[Unit]
Description=PediBot: check the cited sources are alive and current, for the panel

[Service]
Type=oneshot
User=pedibot
WorkingDirectory=/opt/pedibot
EnvironmentFile=/opt/pedibot/.env
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/pedibot/.local/bin/uv run --no-dev python ops/sources_check.py
