[Unit]
Description=PediBot API (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=pedibot
Group=pedibot
WorkingDirectory=/opt/pedibot
EnvironmentFile=/opt/pedibot/.env
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/pedibot/.local/bin/uv run --no-dev pedibot serve --host 127.0.0.1 --port 8601
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/pedibot

[Install]
WantedBy=multi-user.target
