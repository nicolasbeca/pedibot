[Unit]
Description=PediBot, guias nuevas: lunes y jueves a las 06:30 Europe/Madrid

[Timer]
# 20-oct-2026, el operador: «vamos a bajar el ritmo, 2 a la semana». Una guía cada pasada
# (--n 1 en el .service), en la lengua más atrasada. Antes que IndexNow (07:15), para que lo
# escrito esta noche se avise el mismo dia.
OnCalendar=Mon,Thu *-*-* 06:30:00 Europe/Madrid
Persistent=true
Unit=pedibot-publish.service

[Install]
WantedBy=timers.target
