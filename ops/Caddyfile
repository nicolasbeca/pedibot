# /etc/caddy/Caddyfile — PediBot
pedibot.xyz {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), microphone=(self), camera=()"
		-Server
	}

	# Operator panel: basic auth (hash injected by deploy.sh from /etc/caddy/admin.hash)
	@admin path /admin /admin/*
	handle @admin {
		basic_auth {
			nico __ADMIN_HASH__
		}
		reverse_proxy 127.0.0.1:8601
	}

	# API + shared answers → FastAPI
	@api path /api/* /a/*
	handle @api {
		reverse_proxy 127.0.0.1:8601
	}

	# Access log → journald (stderr); the weekly report counts page views from it
	log {
		output stderr
		format json
	}

	# Retired duplicate: two topic keys (heat / golpe_calor) produced two English guides about
	# heatstroke on 26-ago-2026. The surviving one is the one paired with the Spanish version.
	redir /guides/how_do_i_know_if_my_child_has_heat_exhaustion_or_heatstroke /guides/what_should_i_do_if_my_child_has_heat_stroke permanent

	# Static site (Astro build)
	handle {
		root * /opt/pedibot/web/site/dist
		# Astro builds with trailingSlash: 'never', so serve /guides/x directly instead of
		# redirecting it to /guides/x/: every URL in the sitemap and every canonical was
		# answering 308 first (26-ago-2026).
		try_files {path} {path}/index.html /404.html
		file_server {
			disable_canonical_uris
		}
	}

}

www.pedibot.xyz {
	redir https://pedibot.xyz{uri} permanent
}
