# /etc/caddy/Caddyfile — PediBot
pedibot.xyz {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), microphone=(self), camera=()"
		-Server
	}

	# Operator panel: basic auth (hash injected by deploy.sh from /etc/caddy/admin.hash)
	@admin path /admin /admin/*
	handle @admin {
		basic_auth {
			nico __ADMIN_HASH__
		}
		reverse_proxy 127.0.0.1:8601
	}

	# API + shared answers → FastAPI
	@api path /api/* /a/*
	handle @api {
		reverse_proxy 127.0.0.1:8601
	}

	# Access log → journald (stderr); the weekly report counts page views from it
	log {
		output stderr
		format json
	}

	# The 1,442 dose pages (one per brand AND weight) became one page per medicine carrying the
	# whole weight table, on 2-sep-2026: Googlebot had crawled 13 of them in a week and they
	# brought no visits. One pattern redirects every old URL to the page that now answers it.
	@doseweight path_regexp dw ^(/es)?/dose/(.+)-[0-9]+kg/?$
	redir @doseweight {re.dw.1}/dose/{re.dw.2} permanent

	# Retired duplicate: two topic keys (heat / golpe_calor) produced two English guides about
	# heatstroke on 26-ago-2026. The surviving one is the one paired with the Spanish version.
	redir /guides/how_do_i_know_if_my_child_has_heat_exhaustion_or_heatstroke /guides/what_should_i_do_if_my_child_has_heat_stroke permanent

	# Caching. The HTML carried no Cache-Control at all, so browsers fell back to heuristic
	# caching and kept serving an old copy after a deploy — a change was invisible to anyone who
	# had already visited (1-sep-2026). HTML now revalidates every time, which costs one 304 of a
	# few bytes thanks to the ETag; the built assets carry a content hash in the filename, so they
	# can be cached forever and a change simply produces a new name.
	# Matching by extension missed /support and every other clean URL (the file is
	# /support/index.html but the request path has no .html), so the rule is inverted: everything
	# revalidates EXCEPT the built assets, whose filename already carries a content hash.
	@hashed path /_astro/*
	@revalidate not path /_astro/*
	header @revalidate Cache-Control "no-cache"
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# >>> guide redirects (generated by scripts/dedupe_guides.py — do not edit by hand)
	# retired 4-sep-2026: regenerated under a new slug after the verifier refused it for
	# telling readers to dial 999 and NHS 111
	redir /guides/should_i_give_my_child_cough_medicine /guides/cough_medicines_for_kids_what_do_official_guidelines_say permanent
	redir /guides/how_do_i_care_for_my_newborn_at_home /guides/newborn_care_what_do_i_need_to_know permanent
	redir /guides/how_much_screen_time_is_ok_for_my_child /guides/how_does_screen_time_affect_my_child_s_sleep permanent
	redir /guides/my_child_has_diarrhoea_and_vomiting_what_should_i_do /guides/my_child_has_gastroenteritis_what_should_i_do permanent
	redir /guides/what_should_i_do_if_my_child_has_anaphylaxis /guides/anaphylaxis_in_kids_what_do_i_do_now permanent
	redir /guides/what_should_i_do_if_my_child_has_hives /guides/my_child_has_hives_what_should_i_do permanent
	redir /guides/what_should_i_do_if_my_child_swallowed_something_harmful /guides/my_child_touched_or_swallowed_something_toxic_what_do_i_do permanent
	redir /guides/when_should_i_start_weaning_my_baby /guides/when_should_i_start_solid_foods_and_how permanent
	redir /es/guides/mi_hijo_tiene_una_infeccion_de_oido_que_hacer /es/guides/que_hago_si_mi_hijo_tiene_otitis permanent
	redir /es/guides/que_hago_si_mi_hijo_tiene_diarrea_o_vomitos /es/guides/que_hago_si_mi_hijo_tiene_gastroenteritis permanent
	# <<< guide redirects

	# Static site (Astro build)
	handle {
		root * /opt/pedibot/web/site/dist
		# Astro builds with trailingSlash: 'never', so serve /guides/x directly instead of
		# redirecting it to /guides/x/: every URL in the sitemap and every canonical was
		# answering 308 first (26-ago-2026).
		try_files {path} {path}/index.html /404.html
		file_server {
			disable_canonical_uris
		}
	}

}

www.pedibot.xyz {
	redir https://pedibot.xyz{uri} permanent
}

# Otros proyectos alojados en este VPS (Econogar, ...). Cada uno deja su fichero en
# /etc/caddy/sites/ y este import los carga. NO BORRAR: sin esta linea, el despliegue de
# PediBot dejaria a los demas sin HTTPS (deuda D2 de Econogar, 27-ago-2026).
import /etc/caddy/sites/*.caddy
