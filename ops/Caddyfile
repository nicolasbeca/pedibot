# /etc/caddy/Caddyfile — PediBot
pedibot.xyz {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), microphone=(self), camera=()"
		-Server
	}

	# Operator panel: basic auth (hash injected by deploy.sh from /etc/caddy/admin.hash)
	@admin path /admin /admin/*
	handle @admin {
		basic_auth {
			nico __ADMIN_HASH__
		}
		reverse_proxy 127.0.0.1:8601
	}

	# API + shared answers → FastAPI
	@api path /api/* /a/*
	handle @api {
		reverse_proxy 127.0.0.1:8601
	}

	# Access log → journald (stderr); the weekly report counts page views from it
	log {
		output stderr
		format json
	}

	# The 1,442 dose pages (one per brand AND weight) became one page per medicine carrying the
	# whole weight table, on 2-sep-2026: Googlebot had crawled 13 of them in a week and they
	# brought no visits. One pattern redirects every old URL to the page that now answers it.
	@doseweight path_regexp dw ^(/es)?/dose/(.+)-[0-9]+kg/?$
	redir @doseweight {re.dw.1}/dose/{re.dw.2} permanent

	# Retired duplicate: two topic keys (heat / golpe_calor) produced two English guides about
	# heatstroke on 26-ago-2026. The surviving one is the one paired with the Spanish version.
	redir /guides/how_do_i_know_if_my_child_has_heat_exhaustion_or_heatstroke /guides/what_should_i_do_if_my_child_has_heat_stroke permanent

	# Caching. The HTML carried no Cache-Control at all, so browsers fell back to heuristic
	# caching and kept serving an old copy after a deploy — a change was invisible to anyone who
	# had already visited (1-sep-2026). HTML now revalidates every time, which costs one 304 of a
	# few bytes thanks to the ETag; the built assets carry a content hash in the filename, so they
	# can be cached forever and a change simply produces a new name.
	# Matching by extension missed /support and every other clean URL (the file is
	# /support/index.html but the request path has no .html), so the rule is inverted: everything
	# revalidates EXCEPT the built assets, whose filename already carries a content hash.
	# Las tipografías se sirven desde aquí desde el 6-sep-2026, y el nombre que les puso Google
	# ya lleva su hash de contenido — igual que /_astro/, así que se cachean igual. Sin esta línea
	# revalidaban en CADA carga (23 idas y vueltas por página para quien ya las tenía), que es peor
	# que como estaban antes en gstatic. El fonts.css sí revalida: no lleva hash y son 2,4 KB.
	@hashed path /_astro/* /fonts/*.woff2
	@revalidate not path /_astro/* /fonts/*.woff2
	header @revalidate Cache-Control "no-cache"
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# 19-sep-2026, funcionar sin cobertura. Dos cabeceras y las dos son obligatorias, no un
	# adorno:
	#  - el manifiesto tiene que ir como `application/manifest+json`. Caddy deduce el tipo de la
	#    extensión y `.webmanifest` no está en su tabla, así que saldría como octet-stream; con
	#    el `nosniff` de arriba puesto, Chrome lo rechaza y la web deja de poder instalarse.
	#  - el trabajador NO se cachea nunca. Ya revalida por la regla de arriba, pero esto lo deja
	#    dicho donde se lee: si un día se sirve con caché larga, el interruptor de emergencia
	#    —desplegar un sw.js que se desregistre— tardaría un año en llegar a quien ya lo tiene.
	@manifiesto path /manifest.webmanifest
	header @manifiesto Content-Type "application/manifest+json"
	@trabajador path /sw.js
	header @trabajador Cache-Control "no-cache, max-age=0"

	# Una sola dirección por página. Hasta el 7-sep-2026 cada una vivía en dos —con barra final y
	# sin ella—, las dos con 200, y Google les daba puestos distintos: /dose en el 49 y /dose/ en
	# el 70, /es/dose en el 81 y /es/dose/ en el 61. Eso no es un duplicado inofensivo: es la
	# señal de una página repartida entre dos direcciones en vez de sumada.
	#
	# Viene de `disable_canonical_uris`, más abajo, que está ahí por un buen motivo (Astro
	# construye con trailingSlash 'never' y sin él Caddy contestaba un 308 a cada URL del
	# sitemap). El efecto colateral era que la forma con barra dejó de redirigir.
	#
	# El sitemap, las canónicas y todos los enlaces internos usan la forma SIN barra, así que esa
	# es la buena. Fuera se quedan la raíz —no puede redirigir a la cadena vacía— y el API y el
	# panel, porque un 301 sobre un POST lo rompe.
	@trailingslash {
		path_regexp tslash ^(/.+)/$
		not path /api/* /a/* /admin /admin/*
	}
	redir @trailingslash {re.tslash.1} permanent

	# Sacados del registro el 6-sep-2026: 31 peticiones a /sitemap.xml y 8 a /en/, todas 404.
	# El sitemap se llama sitemap-index.xml, y muchos rastreadores solo prueban el nombre de
	# siempre. Y el inglés vive en la raíz mientras los otros siete idiomas llevan prefijo, así
	# que /en/ es lo que cualquiera escribe por simetría — incluida la gente que teclea a mano.
	redir /sitemap.xml /sitemap-index.xml permanent
	@en path_regexp enpfx ^/en(/.*)?$
	redir @en {re.enpfx.1} permanent

	# >>> guide redirects (generated by scripts/sync_redirects.py — do not edit by hand)
