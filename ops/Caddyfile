	# Static site (Astro build)
	handle {
		root * /opt/pedibot/web/site/dist
		# Astro builds with trailingSlash: 'never', so serve /guides/x directly instead of
		# redirecting it to /guides/x/: every URL in the sitemap and every canonical was
		# answering 308 first (26-ago-2026).
		try_files {path} {path}/index.html /404.html
		file_server {
			disable_canonical_uris
		}
	}

}

www.pedibot.xyz {
	redir https://pedibot.xyz{uri} permanent
}

# Otros proyectos alojados en este VPS (Econogar, ...). Cada uno deja su fichero en
# /etc/caddy/sites/ y este import los carga. NO BORRAR: sin esta linea, el despliegue de
# PediBot dejaria a los demas sin HTTPS (deuda D2 de Econogar, 27-ago-2026).
import /etc/caddy/sites/*.caddy
