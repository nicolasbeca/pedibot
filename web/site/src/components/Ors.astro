---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang).ors;
const ages = t(lang).ors_ages;
---
<section class="block" id="ors" data-lang={lang} data-t={JSON.stringify(T)}>
  <p class="eyebrow">ORS</p>
  <h2 style="margin-top:8px">{T.h}</h2>
  <p class="lede">{T.p}</p>
  <div class="ors-form" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end;margin-top:18px">
    <label class="f"><span>{T.age}</span><select id="ors-age">{ages.map(([v, l]) => <option value={v} selected={v === '48'}>{l}</option>)}</select></label>
    <label class="pill" style="padding:10px 14px"><input id="ors-vom" type="checkbox" /> {T.vom}</label>
    <button class="btn btn-primary" id="ors-go" type="button">{T.calc}</button>
  </div>
  <div id="ors-out" class="card" style="margin-top:16px" aria-live="polite"></div>
</section>
<style>
  .f { display: grid; gap: 4px; font-family: Nunito, sans-serif; font-weight: 700; font-size: .9rem; }
  .f select { border: 1px solid var(--line); background: var(--paper); color: var(--ink); border-radius: 12px; padding: 10px 12px; font-weight: 400; font-family: "Atkinson Hyperlegible", sans-serif; }
  #ors-out :global(.warn) { background: var(--amber-soft); border-inline-start: 4px solid var(--amber); border-radius: 10px; padding: 10px 12px; margin-top: 10px; font-size: .92rem; }
  #ors-out :global(.src) { font-size: .8rem; color: var(--ink-3); margin-top: 12px; }
</style>
<script>
  const sec = document.getElementById('ors') as HTMLElement; const T = JSON.parse(sec.dataset.t || '{}'); const lang = sec.dataset.lang || 'en';
  const out = document.getElementById('ors-out')!;
  const esc = (s: string) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  async function go() {
    const age = (document.getElementById('ors-age') as HTMLSelectElement).value; const vom = (document.getElementById('ors-vom') as HTMLInputElement).checked;
    const r = await fetch(`/api/ors?age_months=${age}&vomiting=${vom}&lang=${lang}`); if (!r.ok) return;
    const j = await r.json();
    out.innerHTML = j.lines.map((l: string) => `<p style="margin:6px 0">${esc(l)}</p>`).join('') + j.warnings.map((w: string) => `<div class="warn">⚠️ ${esc(w)}</div>`).join('') + `<p class="src">${T.src}: ${j.sources.map(esc).join(' · ')}</p>`;
  }
  document.getElementById('ors-go')!.addEventListener('click', go); go();
</script>
