---
/**
 * Direct donation block. Renders nothing while DONATION_ADDRESS is empty.
 *
 * No wallet-connect library and no third-party script: an address, a copy button and a link that
 * opens the wallet. /legal promises no third-party requests, and a donation button is not a
 * reason to break that promise. It also means this works with MetaMask, Rabby, Coinbase Wallet
 * or a phone camera without us knowing who donated — which is the point.
 */
import { donationWallets, donationQr, donationUri, liveLinks } from '../donation';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang).donate;
const wallets = donationWallets();
const links = liveLinks();
---
{(wallets.length > 0 || links.length > 0) && (
  <section class="donate">
    <h2>{T.h}</h2>
    <p>
      {T.p}
    </p>
    {links.length > 0 && (
      <p class="links">
        {links.map((l) => (
          <a class="btn btn-primary" href={l.url!} target="_blank" rel="noopener">{l.label} ↗</a>
        ))}
      </p>
    )}
    {wallets.map((w) => (
      <div class="card">
        <div class="qr"><img src={donationQr(w.key)} alt={T.qr_alt} width="132" height="132" loading="lazy" /></div>
        <div class="addr">
          <p class="net">{w.chains.length > 1 ? T.same_on : T.on_network}</p>
          <p class="nets">
            {w.chains.map((c) => (
              <span class={c.recommended ? 'net-tag best' : 'net-tag'}>
                {c.name} <i>{c.coin}</i>{c.recommended ? T.cheapest : ''}
              </span>
            ))}
          </p>
          <code class="mono" data-addr={w.address}>{w.address}</code>
          <p class="row">
            <button class="btn btn-ghost" type="button" data-copy={w.address}>{T.copy}</button>
            {/* Every card gets the button, Solana included. Its QR already encodes
                `solana:<address>` — Solana Pay, which Phantom, Solflare and Backpack open — so
                the card was handing that URI to a phone camera and withholding it from the
                button right underneath it. The network name comes from the wallet, not from the
                sentence: the label once said "(Base)" on the HyperEVM card, which is the one
                place a donor checks before sending. */}
            <a class="btn btn-primary" href={donationUri(w)}>
              {T.open_wallet} ({(w.chains.find((c) => c.id === (w.defaultChainId ?? w.chains[0].id)) ?? w.chains[0]).name})
            </a>
          </p>
        </div>
      </div>
    ))}
    <p class="fine">
      {T.fine}
    </p>
  </section>
)}

{wallets.length > 0 && (
  <script is:inline define:vars={{ copied: T.copied }}>
    // one handler for every card: the address travels on the button, so adding a wallet needs
    // no new id and no new listener
    document.querySelectorAll('[data-copy]').forEach((b) => {
      b.addEventListener('click', async () => {
        const address = b.getAttribute('data-copy');
        const old = b.textContent;
        try {
          await navigator.clipboard.writeText(address);
        } catch (err) {
          const node = document.querySelector(`[data-addr="${address}"]`);
          if (node) {
            const r = document.createRange();
            r.selectNode(node);
            getSelection()?.removeAllRanges();
            getSelection()?.addRange(r);
          }
        }
        b.textContent = copied;
        setTimeout(() => { b.textContent = old; }, 1600);
      });
    });
  </script>
)}

<style>
  .links { display: flex; gap: 10px; flex-wrap: wrap; margin: 4px 0 18px; }
  .donate { margin-top: 34px; }
  .donate .card + .card { margin-top: 12px; }
  .donate .card {
    display: flex; gap: 18px; align-items: center; flex-wrap: wrap;
    background: var(--cream); border: 1px solid var(--line); border-radius: 16px; padding: 16px 18px;
  }
  .donate .qr { background: #fff; border-radius: 10px; padding: 6px; line-height: 0; }
  .donate .addr { flex: 1 1 260px; min-width: 0; }
  .donate .net { margin: 0 0 6px; font-size: .82rem; color: var(--ink-3); }
  .donate .nets { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 10px; }
  .donate .net-tag {
    font-size: .78rem; color: var(--ink-2); background: var(--paper);
    border: 1px solid var(--line); border-radius: 999px; padding: 3px 9px;
  }
  .donate .net-tag.best { border-color: var(--sage); color: var(--sage); }
  .donate .net-tag i { font-style: normal; opacity: .6; }
  .donate code {
    display: block; overflow-wrap: anywhere; font-size: .86rem;
    background: var(--paper); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px;
  }
  .donate .row { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0 0; }
  .donate .fine { font-size: .84rem; color: var(--ink-3); margin-top: 12px; }
</style>
