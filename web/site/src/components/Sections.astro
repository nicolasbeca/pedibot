---
import DosePeek from './DosePeek.astro';
import { t, langPrefix, type Lang } from '../i18n';
import sources from '../data/sources.json';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
// Cards from the catalog: one per organisation, shuffled at build time so the mix is international
const byOrg = new Map<string, { n: number; langs: Set<string>; full: string }>();
for (const d of sources as any[]) {
  if (d.usage === 'excluido') continue;
  const e = byOrg.get(d.org) ?? { n: 0, langs: new Set<string>(), full: d.org_full || d.org };
  e.n += 1; e.langs.add(d.lang); byOrg.set(d.org, e);
}
const blurb: Record<string, Partial<Record<Lang, string>>> = {
  SEUP: { en: 'Spanish paediatric emergency doctors', es: 'Pediatras de urgencias (España)', fr: "Urgentistes pédiatriques (Espagne)" },
  AEP: { en: 'Spanish Paediatric Association', es: 'Asociación Española de Pediatría', fr: 'Association espagnole de pédiatrie' },
  AEPap: { en: 'Spanish primary-care paediatricians', es: 'Pediatras de atención primaria (España)', fr: 'Pédiatres de ville (Espagne)' },
  NHS: { en: 'National Health Service, England', es: 'Servicio Nacional de Salud, Inglaterra', fr: "Service national de santé, Angleterre" },
  CDC: { en: 'US public health agency', es: 'Agencia de salud pública de EE. UU.', fr: 'Agence de santé publique des États-Unis' },
  MedlinePlus: { en: 'US National Library of Medicine', es: 'Biblioteca Nacional de Medicina de EE. UU.', fr: 'Bibliothèque nationale de médecine des États-Unis' },
  WHO: { en: 'World Health Organization', es: 'Organización Mundial de la Salud', fr: 'Organisation mondiale de la santé' },
  AAP: { en: 'American Academy of Pediatrics', es: 'Academia Americana de Pediatría', fr: 'Académie américaine de pédiatrie' },
  'Ministerio de Sanidad': { en: 'Spanish Ministry of Health', es: 'Ministerio de Sanidad (España)', fr: 'Ministère de la Santé (Espagne)' },
  'Junta de Andalucía': { en: 'Regional health service, Andalusia', es: 'Consejería de Salud de Andalucía', fr: "Service régional de santé, Andalousie" },
  'H. Niño Jesús': { en: "Children's hospital, Madrid", es: 'Hospital infantil, Madrid', fr: 'Hôpital pédiatrique, Madrid' },
  AEMPS: { en: 'Spanish medicines agency', es: 'Agencia Española de Medicamentos', fr: 'Agence espagnole du médicament' },
  // llegaron el 11-sep al abrir el corpus a India y Brasil; sin esto salía su nombre largo
  'Ministério da Saúde': { en: 'Brazilian Ministry of Health', es: 'Ministerio de Salud de Brasil', fr: 'Ministère de la Santé du Brésil', pt: 'Ministério da Saúde do Brasil', de: 'Gesundheitsministerium Brasiliens', ru: 'Министерство здравоохранения Бразилии', ar: 'وزارة الصحة البرازيلية', hi: 'ब्राज़ील का स्वास्थ्य मंत्रालय' },
  NHM: { en: "India's National Health Mission", es: 'Misión Nacional de Salud de India', fr: "Mission nationale de santé de l'Inde", pt: 'Missão Nacional de Saúde da Índia', de: 'Nationale Gesundheitsmission Indiens', ru: 'Национальная миссия здравоохранения Индии', ar: 'البعثة الوطنية للصحة في الهند', hi: 'राष्ट्रीय स्वास्थ्य मिशन, भारत' },
  NHSRC: { en: "India's health systems resource centre", es: 'Centro de recursos del sistema de salud de India', fr: 'Centre de ressources du système de santé indien', pt: 'Centro de recursos do sistema de saúde da Índia', de: 'Ressourcenzentrum des indischen Gesundheitssystems', ru: 'Ресурсный центр системы здравоохранения Индии', ar: 'مركز موارد النظام الصحي في الهند', hi: 'भारत का स्वास्थ्य प्रणाली संसाधन केंद्र' },
};
// Ocho organismos, los que más documentos aportan, en orden y sin barajar.
//
// Antes se barajaba el catálogo entero con la fecha como semilla, «para que la mezcla sea
// internacional». Funcionaba mientras la cifra iba escondida dentro de una frase. Desde que la
// cifra es lo primero que se ve (11-sep-2026) el barajado sacaba casillas de «1 documento» al
// lado de una de «74», que queda mal y vende de menos: sólo siete organismos llegan a diez
// documentos y hay veinte en total, así que barajando el «1» era cuestión de tiempo.
//
// Por orden tampoco se pierde la mezcla: salen Estados Unidos, Reino Unido, la OMS, Alemania,
// España y Canadá. Y una lista estable se reconoce al volver, que es más de lo que daba el azar.
const orgs = [...byOrg.entries()]
  .sort((a, b) => b[1].n - a[1].n)
  .slice(0, 8)
  .map(([org, e]) => [org, blurb[org]?.[lang] ?? blurb[org]?.en ?? e.full, e.n] as [string, string, number]);
// una cita de verdad, tal y como el producto las emite, para la tarjeta 2. Sale del
// catálogo y va en el idioma de su fuente, que es exactamente lo que ve un padre
const citada = (sources as any[]).find((d) => d.org === 'NHS' && d.usage !== 'excluido')
  ?? (sources as any[]).find((d) => d.usage !== 'excluido');
const n = (sources as any[]).filter(d => d.usage !== 'excluido').length;
const fill = (text: string) => text.replace(/\{docs\}/g, String(n));
---
<div class="wrap">
  <section class="block" id="how">
    <p class="eyebrow">{s.how_eyebrow}</p>
    <h2 style="margin-top:8px">{s.how_h2}</h2>
    <p class="lede">{s.how_lede}</p>
    <div class="trio">
      <div class="card tint-a" tabindex="0"><span class="n">1</span><h3>{s.how_1t}</h3><p>{s.how_1}</p>
        {/* el semáforo del triaje, sin una palabra: rutina, urgente, emergencia */}
        <div class="show luces" aria-hidden="true"><i class="l1"></i><i class="l2"></i><i class="l3"></i></div>
      </div>
      <div class="card tint-b" tabindex="0"><span class="n">2</span><h3>{s.how_2t}</h3><p>{s.how_2.replace('49', String(n))}</p>
        {/* una cita del catálogo de verdad, en el idioma de su fuente */}
        <div class="show cita"><span class="marca">[1]</span> {citada?.org_full ?? citada?.org} — “{citada?.title}”</div>
      </div>
      <div class="card tint-c" tabindex="0"><span class="n">3</span><h3>{s.how_3t}</h3><p>{s.how_3}</p>
        {/* el corchete es literalmente lo que el motor emite cuando tiene fuente */}
        <div class="show marcas" aria-hidden="true"><span>[1]</span><span>[2]</span><span>[3]</span></div>
      </div>
    </div>
  </section>

  <section class="block" id="dose">
    <p class="eyebrow">{s.dose_eyebrow}</p>
    <h2 style="margin-top:8px">{s.dose_h2}</h2>
    <p class="lede">{s.dose_lede}</p>
    <DosePeek lang={lang} />
  </section>

  <section class="block" id="sources">
    <p class="eyebrow">{s.src_eyebrow}</p>
    <h2 style="margin-top:8px">{s.src_h2}</h2>
    <p class="lede">{s.src_lede}</p>
    <div class="orgs">{orgs.map(([nombre, que, cuantos]) => (
      <div class="org" tabindex="0">
        <span class="cuenta">{cuantos}</span>
        <b>{nombre}</b>
        <span class="que">{que}</span>
      </div>
    ))}</div>
    <p style="margin-top:18px"><a class="btn btn-ghost" href={`${langPrefix(lang)}/sources`}>{s.src_all} ({n})</a></p>
  </section>

  <section class="block" id="channels">
    <p class="eyebrow">{s.channels_eyebrow}</p>
    <h2 style="margin-top:8px">{s.channels_h2}</h2>
    <div class="chan">
      <a class="ch" href={langPrefix(lang) || '/'}><span class="ic">💬</span><b>{s.channels_web}</b><span>{s.channels_web_d}</span></a>
      <a class="ch tg" href="https://t.me/Pedichat_bot" target="_blank" rel="noopener"><span class="ic">✈️</span><b>{s.channels_tg}</b><span>{s.channels_tg_d}</span></a>
      <a class="ch" href="https://x.com/pedibotai" target="_blank" rel="noopener"><span class="ic">𝕏</span><b>{s.channels_x}</b><span>{s.channels_x_d}</span></a>
      <a class="ch" href="https://bsky.app/profile/pedibot.bsky.social" target="_blank" rel="noopener"><span class="ic">🦋</span><b>{s.channels_bs}</b><span>{s.channels_bs_d}</span></a>
      <a class="ch" href={`${langPrefix(lang)}/rss.xml`}><span class="ic">📡</span><b>{s.channels_rss}</b><span>{s.channels_rss_d}</span></a>
    </div>
  </section>

  <section class="block" id="support">
    <div class="support">
      <div>
        <p class="eyebrow">{s.support_eyebrow}</p>
        <h2 style="margin-top:8px">{s.support_h2}</h2>
        <p class="lede">{s.support_p}</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:20px">
          <a class="btn btn-primary" href={`${langPrefix(lang)}/support`}>{s.support_more}</a>
        </div>
      </div>
      {/* The token ledger and its contract addresses used to sit here. They moved to
          /support on 5-sep: a contract address is the last thing a worried parent needs to see
          on the front door, and the token is not what this page is for. */}
      <ul class="never">{s.support_points.map((pt, idx) => <li><span class={idx < 2 ? "no" : "yes"}>{idx < 2 ? "✕" : "✓"}</span>{pt}</li>)}</ul>
    </div>
  </section>
</div>
<style>
    .ll { margin: 26px 0 0; text-align: center; }
    .ll a { display: inline-block; line-height: 0; opacity: .85; transition: opacity .2s; }
    .ll a:hover { opacity: 1; }
    .ll img { width: 260px; height: 65px; }
    .ll .night-only { display: none; }
    :global(html.night) .ll .day { display: none; }
    :global(html.night) .ll .night-only { display: inline-block; }

  .support { display: grid; grid-template-columns: 1.2fr 1fr; gap: 32px; align-items: start; }
  @media (max-width: 800px) { .support { grid-template-columns: 1fr; } }
  .never { margin: 18px 0 0; padding-inline-start: 0; list-style: none; color: var(--ink-2); display: grid; gap: 8px; }
  .never li { display: grid; grid-template-columns: 20px 1fr; gap: 8px; align-items: start; }
  .never .no { color: var(--coral); font-weight: 700; }
  .never .yes { color: var(--sage); font-weight: 700; }
  .ledger { background: var(--paper); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; font-size: .92rem; }
  .ledger div { display: grid; grid-template-columns: 1fr auto; gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--line); }
  .ledger div:last-child { border: 0; }
  .ledger .h { background: var(--cream); font-weight: 700; }
  .ledger .foot { color: var(--ink-3); }
  .chan { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-top: 26px; }
  @media (max-width: 900px) { .chan { grid-template-columns: repeat(2, 1fr); } }
  .ch { display: grid; gap: 2px; padding: 16px; border-radius: 16px; background: var(--paper); border: 1px solid var(--line); text-decoration: none; color: var(--ink); transition: transform .15s, box-shadow .15s; }
  .ch:hover { transform: translateY(-1px); box-shadow: var(--shadow); border-color: var(--mint-2); }
  .ch.tg { background: var(--sky); border-color: transparent; }
  .ch .ic { font-size: 1.3rem; line-height: 1.2; }
  .ch b { font-family: Nunito, sans-serif; }
  .ch span:last-child { color: var(--ink-3); font-size: .84rem; }
  @media (prefers-reduced-motion: reduce) { .ch { transition: none; } }
  .orgs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 26px; }
  @media (max-width: 900px) { .orgs { grid-template-columns: repeat(2, 1fr); } }
  /* la cifra delante y el nombre debajo: lo que se ve de lejos es cuántos documentos aporta
     cada organismo, que es el dato que sostiene todo lo demás */
  .org {
    background: var(--paper); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px;
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
  }
  .org:hover, .org:focus-visible { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--mint-2); outline: none; }
  .org:focus-visible { border-color: var(--focus); }
  .cuenta {
    display: block; font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 1.9rem; line-height: 1; font-weight: 700; color: var(--sage);
    font-variant-numeric: tabular-nums;
  }
  .org b { display: block; font-family: Nunito, sans-serif; margin-top: 4px; }
  /* la descripción sólo al acercarse: de lejos estorba y de cerca es justo lo que se busca */
  .que {
    display: block; font-size: .84rem; color: var(--ink-3);
    max-height: 0; opacity: 0; overflow: hidden;
    transition: max-height .2s ease, opacity .2s ease;
  }
  .org:hover .que, .org:focus-visible .que { max-height: 4em; opacity: 1; }

  /* las tres tarjetas demuestran en vez de contar */
  .card { transition: transform .16s ease, box-shadow .16s ease; }
  .card:hover, .card:focus-visible { transform: translateY(-3px); box-shadow: var(--shadow); outline: none; }
  .show { margin-top: 14px; opacity: .45; transition: opacity .2s ease, transform .2s ease; }
  .card:hover .show, .card:focus-visible .show { opacity: 1; }
  .luces { display: flex; gap: 9px; }
  .luces i { width: 13px; height: 13px; border-radius: 50%; display: block; transition: transform .2s ease; }
  .luces .l1 { background: var(--sage); }
  .luces .l2 { background: var(--amber); }
  .luces .l3 { background: var(--coral); }
  .card:hover .luces .l1 { transform: scale(1.35); }
  .card:hover .luces .l2 { transform: scale(1.35); transition-delay: .07s; }
  .card:hover .luces .l3 { transform: scale(1.35); transition-delay: .14s; }
  .cita {
    font-size: .82rem; color: var(--ink-2); line-height: 1.45;
    border-inline-start: 3px solid var(--amber); padding-inline-start: 10px;
  }
  .cita .marca, .marcas span {
    font-family: 'JetBrains Mono', ui-monospace, monospace; color: var(--sage-deep); font-weight: 700;
  }
  .marcas { display: flex; gap: 10px; font-size: 1.05rem; }
  .card:hover .marcas span:nth-child(2) { transition-delay: .07s; }
  .card:hover .marcas span:nth-child(3) { transition-delay: .14s; }

  @media (prefers-reduced-motion: reduce) {
    .org, .card, .show, .luces i { transition: none; }
    .org:hover, .org:focus-visible, .card:hover, .card:focus-visible { transform: none; }
    .card:hover .luces i { transform: none; }
    .que { max-height: 4em; opacity: 1; }
  }
</style>
