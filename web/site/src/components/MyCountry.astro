---
/**
 * Tu país, en la portada (11-sep-2026; reescrita el 17-sep-2026).
 *
 * PediBot conoce el teléfono de emergencias de 35 países y el calendario vacunal de trece, y nada
 * de eso se veía en la portada. Para un padre en Delhi o en El Cairo —que es a donde el proyecto
 * quiere llegar— eso era justo lo único que hacía falta a las tres de la mañana.
 *
 * Lo que había hasta hoy y por qué no servía, dicho por el operador: era **un desplegable de 35
 * códigos con el Reino Unido puesto de antemano**. Quien entraba en español veía «GB» y tenía que
 * abrir la lista y buscarse; quien entraba en inglés, también. Un número de emergencias que hay
 * que buscar no es un número de emergencias.
 *
 * Ahora la sección abre con los países donde se habla el idioma de la página —los de
 * `config/lang_countries.yaml`— y **cada número está escrito en el HTML**, no puesto por
 * JavaScript. Eso segundo no es un detalle de estilo: un número que sólo existe después de
 * ejecutar un script no lo indexa nadie, y «emergency number in Qatar» es justo la clase de
 * búsqueda que este proyecto puede contestar mejor que casi nadie.
 *
 * Los nombres de país salen de `Intl.DisplayNames`, que también trae Node, así que se escriben al
 * CONSTRUIR y en el idioma de la página. El país del propio lector, si lo sabemos, se pone el
 * primero, y si no estaba se añade: eso sí lo hace JavaScript, porque depende de quién mire.
 */
import { t, langPrefix, type Lang } from '../i18n';
import emergency from '../data/emergency.json';
import vaccines from '../data/vaccines.json';
import langCountries from '../data/lang_countries.json';
import { countryOptions, countryName, flag } from '../countries';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const pref = langPrefix(lang);

const numeros = emergency as Record<string, { emergency?: string; poison?: string;
  mental?: string; note?: string; no_national?: boolean; unverified?: boolean }>;
const conCalendario = Object.keys(vaccines);
const mios: string[] = (langCountries as Record<string, string[]>)[lang] ?? [];
// 19-sep-2026: el desplegable iba ordenado por el CÓDIGO, que no es el orden del alfabeto de
// nadie: en castellano salía Angola (AO) antes que Alemania (DE). Ahora va por el nombre, en
// el idioma de la página, y cada país lleva su bandera delante.
const resto = countryOptions(
  Object.keys(numeros).filter((cc) => !mios.includes(cc)),
  lang
);
const nombres: Record<string, string> = Object.fromEntries(
  Object.keys(numeros).map((cc) => [cc, countryName(cc, lang)])
);
const banderas: Record<string, string> = Object.fromEntries(
  Object.keys(numeros).map((cc) => [cc, flag(cc)])
);
// el `tel:` se queda con el primer número cuando el país da dos («15 / 112»)
const marcar = (cc: string) => String(numeros[cc]?.emergency ?? '').split('/')[0].trim();
---

<!-- 16-sep-2026: esta sección era la única que NO metía su contenido en `.wrap`, así que en
     una pantalla ancha aparecía pegada al borde izquierdo mientras el resto de la página
     estaba centrado en la columna de 1040 px. Lo vio el operador en una captura. -->
<section class="block mine" id="mine">
  <div class="wrap">
    <p class="eyebrow">{s.mine_eyebrow}</p>
    <h2 style="margin-top:8px">{s.mine_h2}</h2>

    <div class="cards" id="mine-cards">
      {mios.map((cc) => (
        <article class="card" data-cc={cc}>
          <h3><span class="bandera" aria-hidden="true">{banderas[cc]}</span>{nombres[cc]}</h3>
          {numeros[cc]?.emergency ? (
            <p class="num">
              <span class="lbl">{s.mine_call}</span>
              <a href={`tel:${marcar(cc)}`}>{numeros[cc].emergency}</a>
            </p>
          ) : (
            <p class="nohay">{numeros[cc]?.no_national ? s.emgc_none : s.emgc_unsure}</p>
          )}
          {numeros[cc]?.poison && <p class="line"><b>{s.mine_poison}:</b> {numeros[cc].poison}</p>}
          {numeros[cc]?.mental && <p class="line"><b>{s.mine_mental}:</b> {numeros[cc].mental}</p>}
          <p class="links">
            <a href={`${pref}/emergency/${cc.toLowerCase()}`}>{s.emg_eyebrow} →</a>
            {conCalendario.includes(cc) && (
              <a href={`${pref}/vaccines/${cc.toLowerCase()}`}>{s.nav_vaccines} →</a>
            )}
          </p>
        </article>
      ))}
    </div>

    <p class="more">
      <label for="mine-cc">{s.mine_more}</label>
      <select id="mine-cc" aria-label={s.mine_more}>
        <option value="">—</option>
        {resto.map((c) => <option value={c.cc}>{c.label}</option>)}
      </select>
      <a class="btn btn-ghost" href={`${pref}/emergency`}>{s.emg_by_country} →</a>
    </p>
  </div>
</section>

<script define:vars={{ NUM: numeros, NOMBRES: nombres, BANDERAS: banderas, CAL: conCalendario, PREF: pref, T: { call: s.mine_call, poison: s.mine_poison, mental: s.mine_mental, emg: s.emg_eyebrow, vax: s.nav_vaccines, none: s.emgc_none, unsure: s.emgc_unsure, yours: s.mine_yours, guess: s.mine_guess, change: s.mine_change } }}>
  const zona = document.getElementById('mine-cards');
  const sel = document.getElementById('mine-cc');

  // 19-sep-2026. El operador entró en la web y le ponía que su país era COLOMBIA. No hay
  // geolocalización en ninguna parte del proyecto: lo que había era una SUPOSICIÓN —lo
  // guardado en el navegador, y si no, la región de `navigator.language`— presentada con
  // la misma cara de certeza que una elección suya, porque el día antes le puse encima una
  // etiqueta que decía «Tu país». Una suposición con etiqueta de hecho es peor que ninguna
  // etiqueta: el lector no sabe que hay nada que corregir.
  //
  // Ahora se distingue de dónde viene. Si lo eligió él, la tarjeta dice «Tu país». Si lo
  // dedujimos nosotros, lo dice preguntando y trae al lado el enlace para cambiarlo, que
  // lleva al desplegable y lo abre.
  const suyo = () => {
    try {
      const guardado = localStorage.getItem('pedibot_country');
      if (guardado && NUM[guardado]) return { cc: guardado, elegido: true };
    } catch (e) {}
    const delIdioma = (navigator.language || '').split('-')[1];
    return delIdioma && NUM[delIdioma] ? { cc: delIdioma, elegido: false } : null;
  };

  const tarjeta = (cc) => {
    const n = NUM[cc] || {};
    const el = document.createElement('article');
    el.className = 'card';
    el.dataset.cc = cc;
    const tel = String(n.emergency || '').split('/')[0].trim();
    const linea = (etiqueta, valor) => (valor ? `<p class="line"><b>${etiqueta}:</b> ${valor}</p>` : '');
    // sin número no se escribe un guion: se escribe la frase, que es la respuesta de verdad
    const cabeza = n.emergency
      ? `<p class="num"><span class="lbl">${T.call}</span><a href="tel:${tel}">${n.emergency}</a></p>`
      : `<p class="nohay">${n.no_national ? T.none : T.unsure}</p>`;
    el.innerHTML =
      `<h3><span class="bandera" aria-hidden="true">${BANDERAS[cc] || ''}</span>${NOMBRES[cc] || cc}</h3>` + cabeza +
      linea(T.poison, n.poison) +
      linea(T.mental, n.mental) +
      `<p class="links"><a href="${PREF}/emergency/${cc.toLowerCase()}">${T.emg} →</a>` +
      (CAL.includes(cc) ? `<a href="${PREF}/vaccines/${cc.toLowerCase()}">${T.vax} →</a>` : '') +
      `</p>`;
    return el;
  };

  // el país del lector va delante: si ya estaba escrito, se mueve; si no, se añade
  const delante = (cc, elegido) => {
    if (!zona || !cc || !NUM[cc]) return;
    zona.querySelectorAll('.tuyo').forEach((otra) => {
      otra.classList.remove('tuyo');
      const vieja = otra.querySelector('.tuyo-lbl');
      if (vieja) vieja.remove();
    });
    const el = zona.querySelector(`[data-cc="${cc}"]`) || tarjeta(cc);
    el.classList.add('tuyo');
    // 18-sep-2026, lo vio el operador: «pongo el idioma que ponga, España sale la primera».
    // Y era verdad y era a propósito —el país del lector va delante, que para una familia
    // marroquí en Madrid es justo lo que hace falta— pero no se decía en ninguna parte, así
    // que parecía un fallo. Ahora la tarjeta lo dice. Un borde de color no es una explicación.
    const lbl = document.createElement('p');
    lbl.className = 'tuyo-lbl' + (elegido ? '' : ' dudosa');
    lbl.textContent = elegido ? T.yours : T.guess;
    if (!elegido) {
      // la corrección, al lado de lo que hay que corregir y no veinte líneas más abajo
      const cambiar = document.createElement('button');
      cambiar.type = 'button';
      cambiar.className = 'cambiar';
      cambiar.textContent = T.change;
      cambiar.addEventListener('click', () => {
        if (!sel) return;
        sel.scrollIntoView({ block: 'center', behavior: 'smooth' });
        sel.focus();
      });
      lbl.append(' ', cambiar);
    }
    el.prepend(lbl);
    zona.prepend(el);
  };

  const mio = suyo();
  if (mio) delante(mio.cc, mio.elegido);

  if (sel) {
    sel.addEventListener('change', () => {
      const cc = sel.value;
      if (!cc) return;
      try { localStorage.setItem('pedibot_country', cc); } catch (e) {}
      delante(cc, true);
      sel.value = '';
    });
  }
</script>

<style>
  .cards {
    display: grid; gap: 14px; margin-top: 18px;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  }
  .card {
    border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; background: var(--paper);
  }
  .card.tuyo { border-color: var(--coral); }
  .tuyo-lbl {
    margin: 0 0 6px; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--coral); font-weight: 700;
  }
  /* Una suposición no se pinta con el mismo color que una certeza: la de coral es la que el
     lector eligió, la gris es la nuestra y lleva al lado el botón de corregirla. */
  .tuyo-lbl.dudosa { color: var(--ink-3); text-transform: none; letter-spacing: 0; font-size: .8rem; }
  .cambiar {
    font: inherit; font-size: .8rem; font-weight: 700; color: var(--coral);
    background: none; border: 0; padding: 0 2px; cursor: pointer; text-decoration: underline;
  }
  .card h3 { margin: 0; font-size: 1rem; }
  /* En Android, iPhone y Mac esto es la bandera. En Windows son las dos letras del país,
     porque Microsoft no las metió en su fuente de emojis; por eso el nombre va siempre al
     lado y la bandera es decoración (aria-hidden). */
  .bandera { margin-inline-end: 7px; }
  .num { margin: 6px 0 4px; }
  /* 18-sep-2026: hay países donde la fuente dice que no hay número nacional. En la tarjeta
     ocupa el sitio del número, porque es la misma respuesta a la misma pregunta. */
  .nohay { margin: 10px 0 4px; font-weight: 700; font-size: 1.02rem; line-height: 1.25; }
  .num .lbl { display: block; font-size: .78rem; color: var(--ink-3); }
  .num a {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: clamp(1.5rem, 5vw, 2rem); line-height: 1.1; color: var(--coral);
    font-variant-numeric: tabular-nums; text-decoration: none;
  }
  .line { margin: 2px 0; font-size: .82rem; color: var(--ink-2); }
  .line b { font-weight: 600; color: var(--ink-3); }
  .links { margin: 10px 0 0; display: flex; gap: 12px; flex-wrap: wrap; font-size: .85rem; }
  .more { margin-top: 20px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .more label { font-size: .84rem; color: var(--ink-3); }
  .more select {
    font: inherit; padding: 8px 12px; border-radius: 12px; border: 1px solid var(--line);
    background: var(--paper); color: var(--ink); min-width: 180px;
  }
</style>
