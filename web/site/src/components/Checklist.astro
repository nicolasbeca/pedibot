---
import data from '../data/checklist.json';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (data.levels as any), C = (data.categories as any);
const order = ['call_now', 'go_today', 'gp'];
const tone: Record<string, string> = { call_now: 'emergency', go_today: 'urgent', gp: 'gp' };
const itemsBy = (lvl: string) => (data.items as any[]).filter(i => i.level === lvl);
---
<div class="check">
  {order.map(lvl => (
    <section class={`lvl ${tone[lvl]}`}>
      <h2>{L[lvl][lang]}</h2>
      <ul>
        {itemsBy(lvl).map(i => <li><span class="cat">{C[i.cat][lang]}</span>{i[lang]}</li>)}
      </ul>
    </section>
  ))}
  <p class="src">{(data.source_label as any)[lang]}. <a href="https://seup.org/pdf_public/pub/hojas_padres/acudir_urgencias.pdf" target="_blank" rel="noopener">PDF</a></p>
</div>
<style>
  .check { display: grid; gap: 18px; margin-top: 28px; }
  .lvl { border-radius: var(--r); padding: 22px 24px; border-left: 6px solid; }
  .lvl.emergency { background: var(--coral-soft); border-color: var(--coral); }
  .lvl.urgent { background: var(--amber-soft); border-color: var(--amber); }
  .lvl.gp { background: var(--mint); border-color: var(--mint-2); }
  .lvl h2 { font-size: 1.15rem; }
  .lvl ul { margin: 12px 0 0; padding-left: 0; list-style: none; display: grid; gap: 8px; }
  .lvl li { display: grid; grid-template-columns: 110px 1fr; gap: 10px; align-items: start; font-size: .98rem; }
  .cat { font-family: Nunito, sans-serif; font-weight: 700; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); padding-top: 3px; }
  @media (max-width: 560px) { .lvl li { grid-template-columns: 1fr; gap: 2px; } }
  .src { font-size: .85rem; color: var(--ink-3); }
</style>
