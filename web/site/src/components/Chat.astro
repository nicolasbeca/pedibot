---
import { t, langPrefix, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
// La lista sale de config/emergency_numbers.yaml (via scripts/export_catalog.py). Era un
// array a mano y se quedó corto: los números conocían 31 países y esto ofrecía 29, así que
// un padre en Perú no podía elegir su país y siempre recibía la frase genérica, teniendo su
// número puesto (7-sep-2026). Un país nuevo en la configuración aparece aquí solo.
import countryCodes from '../data/countries.json';
import { countryOptions } from '../countries';
// 19-sep-2026, y es el fallo más gordo que ha tenido esta caja. Aquí había dos líneas:
// el desplegable mostraba **el código ISO pelado** (AE, AO, AR…) y NO tenía opción vacía, así
// que el primero de la lista alfabética, AE, salía elegido de fábrica y viajaba en cada
// pregunta de quien no lo tocaba. Medido contra lo vivo ese mismo día, en castellano:
//
//   país AE (el de fábrica) → «🚨 Llama ahora al 998 / 999»   ← el número de Emiratos
//   sin país                → «llama al número de tu país (112 en la UE, 911 en América)»
//   país ES                 → «🚨 Llama ahora al 112»
//
// O sea: a un padre en Madrid con el niño morado le estábamos dando un teléfono del Golfo.
// Ahora la primera opción está vacía —sin país se da la frase general, que vale en todas
// partes— y las demás llevan bandera y nombre en el idioma de la página, que es lo que hace
// que alguien se encuentre sin saberse su sigla.
const countries = countryOptions(countryCodes as string[], lang);
const ages = [['', s.not_set], ...s.chat_ages];
---
<div class="stage" data-lang={lang} data-strings={JSON.stringify({ sources: s.sources, helpful: s.helpful, not_helpful: s.not_helpful, share: s.share, copied: s.copied, err_rate: s.err_rate, err_server: s.err_server, err_net: s.err_net, photo_hint: s.photo_hint, child: s.child, listen: s.listen, sug: s.sug, sug_winter: s.sug_winter, sug_summer: s.sug_summer, chat_age_note: s.chat_age_note, chat_weight_note: s.chat_weight_note, speech_locale: s.speech_locale, guide_cta: s.guide_cta, tool_dose: s.dosedrug_open_calc, tool_vaccines: s.vaxcountry_by_age, tool_growth: s.tool_growth, invite_support: s.invite_support, nav_support: s.nav_support, support_href: `${langPrefix(lang)}/support`, err_busy: s.err_busy, err_unavailable: s.err_unavailable, chat_call: s.chat_call, chat_retry: s.chat_retry, ages: s.chat_ages })}>
  <div class="chat" id="thread" aria-live="polite" aria-relevant="additions text">
    <div class="welcome" id="welcome">
      <img class="face" src="/logo.png" width="72" height="72" alt="" />
      <h1>{s.welcome_h1}</h1>
      <p>{s.welcome_p}</p>
      <div class="suggest">
        {s.sug.map(([q, hint], i) => <button class={`sug ${'abcd'[i]}`} type="button" data-q={q}>{q}<small>{hint}</small></button>)}
      </div>
    </div>
  </div>
  <div class="dock">
    <div class="dock-in">
      <div class="ctx">
        <label class="pill">🌍 <select id="country" aria-label={s.vax.country}><option value="">{s.vax.country}</option>{countries.map((c) => <option value={c.cc}>{c.label}</option>)}</select></label>
        <label class="pill">👶 {s.age} <select id="age" aria-label={s.age}>{ages.map(([v, l]) => <option value={v}>{l}</option>)}</select></label>
        <label class="pill">⚖️ {s.weight} <input id="kg" type="number" min="1" max="120" step="0.5" placeholder="kg" aria-label="kg" /></label>
      </div>
      <form class="composer" id="composer">
        <textarea id="input" rows="1" placeholder={s.placeholder} aria-label={s.placeholder}></textarea>
        <button class="mic" type="button" id="photo-btn" aria-label={s.photo} title={s.photo}>📷</button>
        <input id="photo-in" type="file" accept="image/*" capture="environment" hidden />
        <button class="mic" type="button" id="mic" aria-label={s.voice} title={s.voice}>🎤</button>
        <button class="send" type="submit" aria-label={s.send}>➤</button>
      </form>
      <p class="legal">{s.legal_line} · <a href={`${langPrefix(lang)}/emergency`}>{s.nav_emergency}</a> · <a href="https://t.me/Pedichat_bot" target="_blank" rel="noopener">{s.nav_telegram}</a></p>
    </div>
  </div>
</div>

<style>
  /* Sin alto mínimo desde el 16-sep-2026. Reservaba una PANTALLA ENTERA y el compositor
     va fijo abajo de todas formas, así que en la portada —donde debajo hay más secciones—
     lo único que hacía era un agujero en blanco entre las tarjetas y lo siguiente. El hueco
     que hace falta para que el compositor no tape nada lo pone el padding de `.chat`. */
  .stage { display: flex; flex-direction: column; }
  .chat { flex: 1; max-width: 760px; width: 100%; margin: 0 auto; padding: 28px 18px 160px; display: flex; flex-direction: column; gap: 18px; }
  .welcome { text-align: center; padding: 6vh 0 8px; }
  .welcome .face { display: block; margin: 0 auto 18px; }
  .welcome p { color: var(--ink-2); max-width: 46ch; margin: 12px auto 0; }
  .suggest { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 26px; }
  @media (max-width: 560px) { .suggest { grid-template-columns: 1fr; } }
  .sug { text-align: start; background: var(--paper); border: 1px solid var(--line); border-radius: 16px; padding: 14px 16px; cursor: pointer; color: var(--ink); transition: transform .15s, box-shadow .15s; }
  .sug:hover { transform: translateY(-1px); box-shadow: var(--shadow); border-color: var(--mint-2); }
  /* `:global` a propósito: la tarjeta de temporada se reconstruye por JavaScript con
     innerHTML, y ese <small> nace SIN el atributo con el que Astro limita el estilo al
     componente. Resultado en vivo: «…feels dizzy with a feverheat stroke · summer», la
     etiqueta pegada a la frase, sólo en esa tarjeta y sólo en invierno o verano. */
  .sug :global(small) { display: block; color: var(--ink-3); font-size: .8rem; margin-top: 2px; }
  .sug.a { background: var(--mint); } .sug.b { background: var(--peach); } .sug.c { background: var(--lavender); } .sug.d { background: var(--sky); }
  .chat :global(.msg) { max-width: 92%; padding: 14px 18px; border-radius: 20px; line-height: 1.6; }
  .chat :global(.msg.user) { align-self: flex-end; background: var(--mint); border-bottom-right-radius: 6px; }
  .chat :global(.msg.bot) { align-self: flex-start; background: var(--paper); border: 1px solid var(--line); border-bottom-left-radius: 6px; box-shadow: var(--shadow); }
  .chat :global(.who) { font-family: Nunito, sans-serif; font-weight: 700; font-size: .85rem; color: var(--sage); margin-bottom: 6px; }
  .chat :global(.invite) { margin: 14px 0 0; font-size: .88rem; color: var(--ink-2);
    border-top: 1px dashed var(--line); padding-top: 10px; }
  .chat :global(.guide) { margin: 14px 0 0; font-size: .9rem; }
  .chat :global(.guide a) { font-weight: 600; }
  .chat :global(.sources) { margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--line); font-size: .84rem; color: var(--ink-2); }
  .chat :global(.sources b) { color: var(--ink); }
  .chat :global(.sources div) { display: grid; grid-template-columns: auto 1fr; gap: 4px 8px; margin-top: 4px; }
  .chat :global(.foot) { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-size: .78rem; color: var(--ink-3); margin-top: 10px; }
  .chat :global(.fb) { border: 1px solid var(--line); background: var(--paper); border-radius: 999px; padding: 3px 9px; cursor: pointer; color: var(--ink-2); }
  .chat :global(.typing) { display: inline-flex; gap: 4px; padding: 6px 2px; }
  .chat :global(.typing i) { width: 6px; height: 6px; border-radius: 50%; background: var(--ink-3); animation: blink 1.2s infinite; }
  .chat :global(.typing i:nth-child(2)) { animation-delay: .2s; } .chat :global(.typing i:nth-child(3)) { animation-delay: .4s; }
  @keyframes blink { 0%, 80%, 100% { opacity: .25 } 40% { opacity: 1 } }
  .dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 15; background: linear-gradient(to top, var(--ground) 70%, transparent); padding: 18px 12px 14px; }
  /* The composer is pinned to the bottom of the window, so it floated over the end of the page
     for good: the footer was unreadable and its links unclickable (reported 2-sep-2026). The
     page now reserves exactly the height the composer takes — measured in the script below,
     because the textarea grows as you type — with a sensible default in case the script never
     runs. Only the pages that carry the chat get it. */
  :global(body:has(.dock)),
  :global(body.has-dock) { padding-bottom: var(--dock-h, 132px); } /* the class covers browsers without :has() */
  .dock-in { max-width: 760px; margin: 0 auto; }
  .ctx { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
  .ctx .pill { background: var(--cream); }
  .ctx input { width: 64px; border: 0; background: transparent; color: inherit; }
  .composer { display: flex; align-items: flex-end; gap: 8px; background: var(--paper); border: 1px solid var(--line); border-radius: 26px; padding: 8px 8px 8px 18px; box-shadow: var(--shadow); }
  .composer textarea { flex: 1; border: 0; background: transparent; color: var(--ink); resize: none; max-height: 140px; padding: 8px 0; line-height: 1.5; }
  .mic { width: 40px; height: 40px; border: 0; border-radius: 50%; background: var(--cream); cursor: pointer; font-size: 1rem; }
  .mic.on { background: var(--coral-soft); }
  .chat :global(.call) { display: inline-block; margin: 10px 0 4px; padding: 12px 18px; border-radius: 999px; background: var(--coral); color: #fff; font-weight: 700; font-size: 1.05rem; text-decoration: none; }
  .chat :global(.call:active) { transform: scale(.98); }
  .chat :global(.opts.next) { margin-top: 10px; }
  .chat :global(.opts.next .opt) { padding: 6px 12px; }
  .send { width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--sage); color: #fff; cursor: pointer; font-size: 1.1rem; display: grid; place-items: center; }
  :global(:root.night) .send { color: var(--ground); }
  .legal { text-align: center; font-size: .74rem; color: var(--ink-3); margin-top: 8px; }
  @media (prefers-reduced-motion: reduce) { .chat :global(.typing i) { animation: none; } .sug { transition: none; } }
</style>

<script>
  const stage = document.querySelector('.stage') as HTMLElement;
  const lang = stage.dataset.lang || 'en';
  const S = JSON.parse(stage.dataset.strings || '{}');
  const thread = document.getElementById('thread')!, welcome = document.getElementById('welcome')!;
  const form = document.getElementById('composer') as HTMLFormElement, input = document.getElementById('input') as HTMLTextAreaElement;
  const countrySel = document.getElementById('country') as HTMLSelectElement, ageSel = document.getElementById('age') as HTMLSelectElement, kgIn = document.getElementById('kg') as HTMLInputElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Un navegador que abrió /admin es del equipo: pregunta como `test` y no sale en el panel.
  const CLIENT = (() => { try { return localStorage.getItem('pedibot_team') ? 'test' : 'web'; } catch (e) { return 'web'; } })();
  let session: string | null = null;
  try { session = localStorage.getItem('pedibot_session'); const c = localStorage.getItem('pedibot_country'); if (c) countrySel.value = c; } catch (e) {}
  try { const loc = (navigator.language || '').split('-')[1]; if (loc && !localStorage.getItem('pedibot_country') && [...countrySel.options].some(o => o.value === loc)) countrySel.value = loc; } catch (e) {}
  countrySel.addEventListener('change', () => { try { localStorage.setItem('pedibot_country', countrySel.value); } catch (e) {} });

  const esc = (s: string) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  function bubble(cls: string, html: string) { welcome.style.display = 'none'; const d = document.createElement('div'); d.className = 'msg ' + cls; d.innerHTML = html; thread.appendChild(d); d.scrollIntoView({ block: 'end', behavior: reduced ? 'auto' : 'smooth' }); return d; }
  function render(j: any) {
    // Operator decision 25-ago: no source list, no [n] markers, no per-message disclaimer.
    // The organisation is named inside the text; the legal line lives under the composer.
    let h = '<div class="who">pedibot</div>';
    if (j.banner) { const lines = String(j.banner).split('\n'); h += `<div class="banner ${j.level}" role="alert">${esc(lines[0])}<small>${esc(lines.slice(1).join(' '))}</small></div>`; }
    // Con el niño en brazos, marcar tiene que ser un toque: la API manda el número sólo con
    // nivel emergencia y país conocido, y aquí se pinta como tel:.
    if (j.call) h += `<a class="call" href="tel:${esc(String(j.call))}">📞 ${esc(S.chat_call)} ${esc(String(j.call))}</a>`;
    h += '<div class="txt">' + esc(String(j.text).replace(/\s*\[\d{1,2}\]/g, '')).replace(/\n/g, '<br>') + '</div>';
    // The guide built from the same sources this answer used. Its own title is the link text:
    // that is what tells the reader whether it is worth opening.
    if (j.guide?.url) h += `<p class="guide">📄 ${S.guide_cta}: <a href="${esc(j.guide.url)}">${esc(j.guide.title)}</a></p>`;
    // The page of this site that answers the same question better than prose: the vaccination
    // table for the country, or the dose calculator. The engine sends the KIND, the words live
    // here — in i18n.ts, in eight languages, where every other word on the site lives.
    if (j.tool?.url) {
      const label = j.tool.kind === 'vaccines' ? S.tool_vaccines : j.tool.kind === 'growth' ? S.tool_growth : S.tool_dose;
      const icon = j.tool.kind === 'vaccines' ? '💉' : j.tool.kind === 'growth' ? '📏' : '💊';
      h += `<p class="guide">${icon} <a href="${esc(j.tool.url)}">${esc(label)}</a></p>`;
    }
    // Once, on a calm fifth question of the day. Never over an answer with a warning sign: a
    // parent whose child has just had a seizure is not asked for money.
    if (j.invite) h += `<p class="invite">${esc(S.invite_support)} <a href="${esc(S.support_href)}">${esc(S.nav_support)} →</a></p>`;
    // Cuando pide la edad (6 % de las respuestas), un toque en vez de teclear: las mismas
    // edades del chip, ya traducidas. El servidor recuerda la pregunta (medido en las ocho).
    if (j.verification === 'asked_age' && Array.isArray(S.ages)) { h += '<div class="opts">' + S.ages.map((a: [string, string]) => `<button class="fb opt" type="button" data-age="${esc(a[0])}" data-q="${esc(a[1])}">${esc(a[1])}</button>`).join(' ') + '</div>'; return h; }
    if (j.verification === 'clarify' && j.options?.length) { h += '<div class="opts">' + j.options.map((o: string) => `<button class="fb opt" type="button" data-q="${esc(o)}">${esc(o)}</button>`).join(' ') + '</div>'; return h; }
    // Fiebre sin edad: la respuesta ya está dada; los botones de edad van DEBAJO, para afinar.
    if (j.ask_age && Array.isArray(S.ages)) h += '<div class="opts">' + S.ages.map((a: [string, string]) => `<button class="fb opt" type="button" data-age="${esc(a[0])}" data-q="${esc(a[1])}">${esc(a[1])}</button>`).join(' ') + '</div>';
    // Las preguntas que vienen después: la API las manda según el asunto de la respuesta, en la
    // lengua del padre, y cada una tiene fuente (config/followups.yaml). Van por `.opt` → ask().
    if (Array.isArray(j.followups) && j.followups.length) h += '<div class="opts next">' + j.followups.map((o: string) => `<button class="fb opt" type="button" data-q="${esc(o)}">${esc(o)}</button>`).join(' ') + '</div>';
    h += `<div class="foot"><span></span><span><button class="fb" data-v="1" data-id="${j.answer_id}" type="button" aria-label="${S.helpful}">👍</button> <button class="fb" data-v="-1" data-id="${j.answer_id}" type="button" aria-label="${S.not_helpful}">👎</button> <button class="fb share" data-id="${j.answer_id}" type="button">🔗 ${S.share}</button>${j.verification === 'ok' || j.verification === 'regenerated' ? ` <button class="fb child" data-q="${esc(j.question || '')}" type="button">🧸 ${S.child}</button> <button class="fb listen" type="button">🔊 ${S.listen}</button>` : ''}</span></div>`;
    return h;
  }
  function context(q: string) {
    // age/weight chips are sent as part of the message so triage and the dose router see them
    const parts = [q];
    if (ageSel.value && !/(\d\s*(años?|mes(es)?|years?|months?|weeks?|semanas?|ans?|mois|semaines?|jahre?|monate?|wochen?|лет|год|мес|нед|anos?|साल|महीन|हफ़?्त|सप्ताह|أشهر|سنوات|شهر|سنة|أسابيع)|أسبوعان|شهران|سنتان|سنة)/i.test(q)) parts.push(`(${S.chat_age_note.replace('{v}', ageSel.value)})`);
    if (kgIn.value && !/\bkg|kilos?\b/i.test(q)) parts.push(`(${S.chat_weight_note.replace('{v}', kgIn.value)})`);
    return parts.join(' ');
  }
  async function ask(q: string, mode: 'parent' | 'child' = 'parent') {
    bubble('user', esc(mode === 'child' ? '🧸 ' + q : q));
    const t = bubble('bot', '<div class="who">pedibot</div><span class="typing"><i></i><i></i><i></i></span>');
    try {
      const r = await fetch('/api/ask', { method: 'POST', headers: { 'content-type': 'application/json', 'x-pedibot-client': CLIENT }, body: JSON.stringify({ question: context(q), country: countrySel.value || null, lang, session, mode }) });
      if (r.status === 429) { t.innerHTML = '<div class="who">pedibot</div>' + S.err_rate; return; }
      // «espera un poco», «ahora no puedo» y «se nos ha roto algo» piden cosas distintas del
      // padre, y las tres se contestaban con la tercera. Un 429 es un límite nuestro, no una
      // avería: decirle «hemos fallado» lo deja reintentando, que es lo que alarga el bloqueo.
      const retry = `<div class="opts"><button class="fb retry" type="button" data-q="${esc(q)}">↻ ${esc(S.chat_retry)}</button></div>`;
      if (!r.ok) { t.innerHTML = '<div class="who">pedibot</div>' + (r.status === 429 ? S.err_busy : r.status === 503 ? S.err_unavailable + retry : S.err_server + retry); return; }
      const j = await r.json(); j.question = q; session = j.session; try { localStorage.setItem('pedibot_session', session!); } catch (e) {}
      t.innerHTML = render(j);
    } catch (e) { t.innerHTML = '<div class="who">pedibot</div>' + S.err_net + `<div class="opts"><button class="fb retry" type="button" data-q="${esc(q)}">↻ ${esc(S.chat_retry)}</button></div>`; }
    t.scrollIntoView({ block: 'end' });
  }
  thread.addEventListener('click', async e => {
    const b = (e.target as HTMLElement).closest('.fb') as HTMLButtonElement | null; if (!b) return;
    if (b.classList.contains('share')) {
      const r = await fetch('/api/share', { method: 'POST', headers: { 'content-type': 'application/json', 'x-pedibot-client': CLIENT }, body: JSON.stringify({ answer_id: Number(b.dataset.id), session }) });
      if (r.ok) { const j = await r.json(); const url = location.origin + j.path; try { await navigator.clipboard.writeText(url); b.textContent = '✓ ' + S.copied; } catch (err) { prompt(S.share, url); } }
      return;
    }
    // Una respuesta rápida es una PREGUNTA. Sin esta línea caía al voto de abajo con
    // answer_id=NaN y los botones se desactivaban: las opciones nunca habían funcionado.
    if (b.classList.contains('opt')) { if (b.dataset.age !== undefined) ageSel.value = b.dataset.age; ask(b.dataset.q || ''); return; }
    // Reintentar: se quita el error y la pregunta que lo provocó, y se vuelve a mandar.
    if (b.classList.contains('retry')) { const m = b.closest('.msg') as HTMLElement; const prev = m.previousElementSibling; if (prev?.classList.contains('user')) prev.remove(); m.remove(); ask(b.dataset.q || ''); return; }
    if (b.classList.contains('child')) { ask(b.dataset.q || '', 'child'); return; }
    if (b.classList.contains('listen')) {
      // Lee la respuesta, no los botones («📄 Guía…», «📞 Llamar…»); un segundo toque la calla.
      if (speechSynthesis.speaking) { speechSynthesis.cancel(); return; }
      const msg = b.closest('.msg') as HTMLElement; const txt = msg.querySelector('.txt') as HTMLElement | null; const text = txt ? txt.innerText : msg.innerText.replace(/^pedibot/, '').replace(/👍.*$/s, '');
      const u = new SpeechSynthesisUtterance(text); u.lang = S.speech_locale; speechSynthesis.speak(u); return;
    }
    await fetch('/api/feedback', { method: 'POST', headers: { 'content-type': 'application/json', 'x-pedibot-client': CLIENT }, body: JSON.stringify({ answer_id: Number(b.dataset.id), session, value: Number(b.dataset.v) }) });
    b.parentElement!.querySelectorAll('.fb').forEach(x => (x as HTMLButtonElement).disabled = true); b.textContent += ' ✓';
  });
  document.addEventListener('click', e => { const b = (e.target as HTMLElement).closest('.sug') as HTMLElement | null; if (b?.dataset.q) ask(b.dataset.q); });
  form.addEventListener('submit', e => { e.preventDefault(); const q = input.value.trim(); if (!q) return; input.value = ''; input.style.height = 'auto'; ask(q); });
  input.addEventListener('input', () => { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 140) + 'px'; });
  input.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); } });
  const pre = new URLSearchParams(location.search).get('q'); if (pre) { input.value = pre; }

  // photo check (warning signs only): resize in the browser, send base64, render as a bot message
  const photoBtn = document.getElementById('photo-btn') as HTMLButtonElement, photoIn = document.getElementById('photo-in') as HTMLInputElement;
  photoBtn.addEventListener('click', () => { if (confirm(S.photo_hint)) photoIn.click(); });
  photoIn.addEventListener('change', async () => {
    const file = photoIn.files?.[0]; if (!file) return; photoIn.value = '';
    const img = new Image(); img.src = URL.createObjectURL(file); await img.decode();
    const max = 1024, k = Math.min(1, max / Math.max(img.width, img.height));
    const cv = document.createElement('canvas'); cv.width = Math.round(img.width * k); cv.height = Math.round(img.height * k);
    cv.getContext('2d')!.drawImage(img, 0, 0, cv.width, cv.height);
    const b64 = cv.toDataURL('image/jpeg', 0.85).split(',')[1];
    bubble('user', '📷 ' + esc(file.name));
    const t = bubble('bot', '<div class="who">pedibot</div><span class="typing"><i></i><i></i><i></i></span>');
    try {
      const r = await fetch('/api/photo', { method: 'POST', headers: { 'content-type': 'application/json', 'x-pedibot-client': CLIENT }, body: JSON.stringify({ image_b64: b64, mime: 'image/jpeg', lang, country: countrySel.value || null, session }) });
      // el ternario que había aquí tenía las DOS ramas iguales: alguien quiso distinguir el
      // 503 y no terminó. La lectura de fotos se apaga sola sin saldo, así que ese caso es el
      // más probable de los tres.
      if (!r.ok) { t.innerHTML = '<div class="who">pedibot</div>' + (r.status === 429 ? S.err_busy : r.status === 503 ? S.err_unavailable : S.err_server); return; }
      const j = await r.json(); session = j.session; try { localStorage.setItem('pedibot_session', session!); } catch (e) {}
      let hh = '<div class="who">pedibot</div>';
      if (j.level === 'emergency' || j.level === 'urgent') hh += `<div class="banner ${j.level}" role="alert">🚨 ${esc(j.text.split('. ')[0])}.</div>`;
      hh += esc(j.text).replace(/\n/g, '<br>');
      t.innerHTML = hh;
    } catch (e) { t.innerHTML = '<div class="who">pedibot</div>' + S.err_net; }
    t.scrollIntoView({ block: 'end' });
  });

  // voice input (Web Speech API, free, in-browser)
  const mic = document.getElementById('mic') as HTMLButtonElement;
  const SR = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
  if (!SR) mic.style.display = 'none';
  else mic.addEventListener('click', () => {
    const rec = new SR(); rec.lang = S.speech_locale; rec.interimResults = false; mic.classList.add('on');
    rec.onresult = (ev: any) => { input.value = (input.value ? input.value + ' ' : '') + ev.results[0][0].transcript; input.dispatchEvent(new Event('input')); };
    rec.onend = () => mic.classList.remove('on'); rec.onerror = () => mic.classList.remove('on'); rec.start();
  });

  // seasonal suggestion (I-27): replace the last card by the season's frequent question
  // keep --dock-h in step with the real height of the composer (it grows with the textarea)
  const dock = document.querySelector('.dock') as HTMLElement | null;
  if (dock) {
    document.body.classList.add('has-dock');
    const measure = () =>
      document.documentElement.style.setProperty('--dock-h', `${dock.offsetHeight + 8}px`);
    measure();
    addEventListener('resize', measure);
    if ('ResizeObserver' in window) new ResizeObserver(measure).observe(dock);
  }

  const month = new Date().getMonth() + 1; const south = ['AU', 'NZ', 'AR', 'CL', 'BR'].includes(countrySel.value);
  const winter = south ? (month >= 6 && month <= 9) : (month >= 11 || month <= 3);
  const summer = south ? (month >= 12 || month <= 2) : (month >= 6 && month <= 9);
  const card = document.querySelector('.sug.d') as HTMLElement | null; const pick = winter ? S.sug_winter : summer ? S.sug_summer : null;
  if (card && pick) { card.dataset.q = pick[0]; card.innerHTML = esc(pick[0]) + '<small>' + esc(pick[1]) + '</small>'; }
</script>
