---
/* El buscador de números de urgencias (30-sep-2026). El operador, sobre la página de antes:
   «infumable, todo ahí al mogollón» —95 tarjetas en rejilla—. Ahora:

   1. arriba, EL número del lector, grande y marcable: casi todo el que entra busca sólo el suyo.
      Se toma de lo que eligió en la web (`pedibot_country`), y si no eligió nada, de la región
      del navegador, dicho como pregunta («¿Es tu país?»), igual que en la portada;
   2. un desplegable doble, continente → país, en cualquier pantalla;
   3. en pantallas anchas, el mapamundi (public/world.svg, scripts/build_world_map.py): se pincha
      un país y la tarjeta de arriba cambia. En el teléfono no se descarga.

   Sin JavaScript sigue sirviendo: el desplegable de países lleva todos, agrupados por continente,
   y el botón lleva a la página del país. */
import emergency from '../data/emergency.json';
import continents from '../data/continents.json';
import { t, langPrefix, type Lang } from '../i18n';
import { flag } from '../countries';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const E = s.emf;
const pref = langPrefix(lang);
const numeros = emergency as Record<string, any>;
const cont = continents as Record<string, string>;
const ORDEN = ['africa', 'asia', 'europe', 'north_america', 'south_america', 'oceania'] as const;

let nombreDe = (cc: string) => cc;
try {
  const dn = new Intl.DisplayNames([lang], { type: 'region' });
  nombreDe = (cc: string) => dn.of(cc) || cc;
} catch (e) {}

const porContinente = ORDEN.map((c) => ({
  c,
  paises: Object.keys(numeros)
    .filter((cc) => cont[cc] === c)
    .map((cc) => ({ cc, nombre: nombreDe(cc) }))
    .sort((a, b) => a.nombre.localeCompare(b.nombre, lang)),
})).filter((g) => g.paises.length);

// Lo que viaja al navegador, compacto y en la lengua de la página: [número, toxicología, salud
// mental, nota, sin número nacional]. Las notas en las ocho lenguas multiplicaban el peso por 8.
const DATOS: Record<string, [string | null, string | null, string | null, string | null, boolean]> = {};
for (const [cc, n] of Object.entries(numeros)) {
  DATOS[cc] = [n.emergency ?? null, n.poison ?? null, n.mental ?? null,
    (n.note && (n.note[lang] || n.note.en)) || null, Boolean(n.no_national)];
}
const NOMBRES = Object.fromEntries(Object.keys(numeros).map((cc) => [cc, nombreDe(cc)]));
const BANDERAS = Object.fromEntries(Object.keys(numeros).map((cc) => [cc, flag(cc)]));
---
<section class="emf" id="by-country" aria-labelledby="emf-h">
  <h2 id="emf-h">{E.h}</h2>

  <div class="big" id="emf-big" aria-live="polite">
    <p class="empty">{E.choose}</p>
  </div>

  <form class="pick" action={`${pref}/emergency`} method="get" id="emf-form">
    <label>{E.continent}
      <select id="emf-cont">
        <option value="">—</option>
        {porContinente.map((g) => <option value={g.c}>{E[g.c]}</option>)}
      </select>
    </label>
    <label>{E.country}
      <select id="emf-cc" name="cc">
        <option value="">{E.choose}</option>
        {porContinente.map((g) => (
          <optgroup label={E[g.c]} data-c={g.c}>
            {g.paises.map((p) => <option value={p.cc}>{p.nombre}</option>)}
          </optgroup>
        ))}
      </select>
    </label>
    <noscript><button class="btn" type="submit">→</button></noscript>
  </form>

  <div class="map" id="emf-map" hidden>
    <p class="map-hint">{E.map}</p>
    <div class="map-box" id="emf-svg"></div>
  </div>

  <details class="all">
    <summary>{E.all}</summary>
    {porContinente.map((g) => (
      <div class="all-g">
        <h3>{E[g.c]}</h3>
        <ul>
          {g.paises.map((p) => (
            <li><a href={`${pref}/emergency/${p.cc.toLowerCase()}`}>
              <span class="bandera" aria-hidden="true">{flag(p.cc)}</span>{p.nombre}
              <b class={numeros[p.cc]?.emergency ? '' : 'sin'}>{numeros[p.cc]?.emergency ?? '—'}</b>
            </a></li>
          ))}
        </ul>
      </div>
    ))}
  </details>
</section>

<script is:inline define:vars={{ DATOS, NOMBRES, BANDERAS, CONT: cont, PREF: pref,
  T: { call: s.mine_call, poison: s.mine_poison, mental: s.mine_mental, none: s.emgc_none, unsure: s.emgc_unsure,
       yours: s.mine_yours, guess: s.mine_guess, page: s.emgc_h1 } }}>
  const big = document.getElementById('emf-big');
  const selC = document.getElementById('emf-cont');
  const selP = document.getElementById('emf-cc');
  const esc = (x) => String(x).replace(/&/g, '&amp;').replace(/</g, '&lt;');

  const pinta = (cc, elegido) => {
    const d = DATOS[cc];
    if (!d || !big) return;
    const [num, tox, mental, nota, sinNacional] = d;
    const tel = String(num || '').split('/')[0].replace(/[^\d+]/g, '');
    big.innerHTML =
      `<p class="who ${elegido ? '' : 'dudosa'}">${elegido ? T.yours : T.guess}</p>` +
      `<h3><span class="bandera" aria-hidden="true">${BANDERAS[cc] || ''}</span>${esc(NOMBRES[cc] || cc)}</h3>` +
      (num
        ? `<p class="num"><span class="lbl">${esc(T.call)}</span><a href="tel:${tel}">${esc(num)}</a></p>`
        : `<p class="nohay">${esc(sinNacional ? T.none : T.unsure)}</p>`) +
      (nota ? `<p class="nota">${esc(nota)}</p>` : '') +
      (tox ? `<p class="line"><b>${esc(T.poison)}:</b> ${esc(tox)}</p>` : '') +
      (mental ? `<p class="line"><b>${esc(T.mental)}:</b> ${esc(mental)}</p>` : '') +
      `<p class="more"><a href="${PREF}/emergency/${cc.toLowerCase()}">${esc(T.page.replace('{name}', NOMBRES[cc] || cc))} →</a></p>`;
    if (selC) selC.value = CONT[cc] || '';
    filtra();
    if (selP) selP.value = cc;
    document.querySelectorAll('#emf-svg path.sel').forEach((p) => p.classList.remove('sel'));
    document.querySelectorAll(`#emf-svg path[data-cc="${cc}"]`).forEach((p) => p.classList.add('sel'));
  };

  // el continente filtra el desplegable de países (sin JavaScript se ven todos, agrupados)
  const filtra = () => {
    if (!selP) return;
    const c = selC ? selC.value : '';
    selP.querySelectorAll('optgroup').forEach((g) => { g.hidden = Boolean(c) && g.dataset.c !== c; g.disabled = Boolean(c) && g.dataset.c !== c; });
  };

  const elige = (cc) => {
    if (!DATOS[cc]) return;
    try { localStorage.setItem('pedibot_country', cc); } catch (e) {}
    pinta(cc, true);
  };

  selC?.addEventListener('change', () => { filtra(); if (selP) selP.value = ''; });
  selP?.addEventListener('change', () => { if (selP.value) elige(selP.value); });
  document.getElementById('emf-form')?.addEventListener('submit', (e) => e.preventDefault());

  // el país del lector: lo que eligió, o la región del navegador dicha como pregunta
  let mio = null;
  try { const g = localStorage.getItem('pedibot_country'); if (g && DATOS[g]) mio = [g, true]; } catch (e) {}
  if (!mio) { const r = (navigator.language || '').split('-')[1]; if (r && DATOS[r.toUpperCase()]) mio = [r.toUpperCase(), false]; }
  if (mio) pinta(mio[0], mio[1]);

  // el mapa, sólo en pantallas anchas: en el teléfono no se descarga
  const caja = document.getElementById('emf-map');
  if (caja && window.matchMedia('(min-width: 760px)').matches) {
    fetch('/world.svg').then((r) => (r.ok ? r.text() : '')).then((svg) => {
      if (!svg) return;
      const box = document.getElementById('emf-svg');
      box.innerHTML = svg;
      caja.hidden = false;
      box.querySelectorAll('path[data-cc]').forEach((p) => {
        const cc = p.dataset.cc;
        const t = document.createElementNS('http://www.w3.org/2000/svg', 'title');
        t.textContent = `${NOMBRES[cc] || cc}: ${DATOS[cc]?.[0] || '—'}`;
        p.appendChild(t);
        p.addEventListener('click', () => elige(cc));
      });
      if (mio) box.querySelectorAll(`path[data-cc="${mio[0]}"]`).forEach((p) => p.classList.add('sel'));
    }).catch(() => {});
  }
</script>

<style>
  .emf { margin-top: 26px; }
  .big { margin-top: 14px; border: 2px solid var(--coral-soft); border-radius: var(--r); background: var(--paper);
    padding: 20px 22px; box-shadow: var(--shadow); }
  .big .empty { margin: 0; color: var(--ink-2); font-size: 1.05rem; }
  .big :global(.who) { margin: 0; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--coral); }
  .big :global(.who.dudosa) { color: var(--ink-3); }
  .big :global(h3) { margin: 4px 0 0; font-size: 1.35rem; }
  .big :global(.bandera) { margin-inline-end: 8px; }
  .big :global(.num) { margin: 6px 0 0; display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .big :global(.num .lbl) { color: var(--ink-2); }
  .big :global(.num a) { font-family: 'JetBrains Mono', ui-monospace, monospace; font-weight: 700; font-size: clamp(2.4rem, 9vw, 3.6rem);
    line-height: 1.05; color: var(--coral); text-decoration: none; font-variant-numeric: tabular-nums; }
  .big :global(.nohay) { margin: 8px 0 0; font-size: 1.2rem; font-weight: 700; }
  .big :global(.nota) { margin: 8px 0 0; color: var(--ink-2); }
  .big :global(.line) { margin: 6px 0 0; color: var(--ink-2); }
  .big :global(.more) { margin: 12px 0 0; }

  .pick { margin-top: 16px; display: flex; gap: 12px; flex-wrap: wrap; }
  .pick label { display: flex; flex-direction: column; gap: 4px; font-size: .85rem; font-weight: 700; color: var(--ink-2); flex: 1 1 220px; min-width: 0; }
  .pick select { font: inherit; font-weight: 400; font-size: 1rem; padding: 10px 12px; border: 1px solid var(--line);
    border-radius: 12px; background: var(--paper); color: var(--ink); width: 100%; }

  .map { margin-top: 18px; }
  .map-hint { margin: 0 0 8px; color: var(--ink-3); font-size: .88rem; }
  .map-box { max-width: 820px; margin: 0 auto; }
  .map-box :global(svg) { width: 100%; height: auto; display: block; }
  .map-box :global(path.c) { fill: var(--line); stroke: var(--ground); stroke-width: .6; }
  .map-box :global(path.on) { fill: var(--mint-2); cursor: pointer; transition: fill .12s ease; }
  .map-box :global(path.on:hover) { fill: var(--coral-soft); }
  .map-box :global(path.sel) { fill: var(--coral); }

  .all { margin-top: 20px; }
  .all summary { cursor: pointer; font-weight: 700; color: var(--sage); }
  .all-g h3 { font-size: .8rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); margin: 16px 0 6px; }
  .all-g ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px 18px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .all-g a { display: flex; justify-content: space-between; gap: 10px; padding: 6px 4px; text-decoration: none; color: inherit; border-bottom: 1px solid var(--line); }
  .all-g .bandera { margin-inline-end: 6px; }
  .all-g b { font-family: 'JetBrains Mono', ui-monospace, monospace; color: var(--coral); white-space: nowrap; }
  .all-g b.sin { color: var(--ink-3); }
</style>
