---
import Base from '../layouts/Base.astro';
import Chat from '../components/Chat.astro';
import Sections from '../components/Sections.astro';
const lang = 'en';
const jsonld = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'PediBot', applicationCategory: 'HealthApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0' }, description: 'Free assistant for parents that answers only from published paediatric guidelines and cites the page.' };
---
<Base lang={lang} title="PediBot — paediatric guidance with sources" description="Free assistant for parents that answers only from published paediatric guidelines, names the source in every sentence, and tells you when to go to the emergency department." path="/" jsonld={jsonld}>
  <Chat lang={lang} />
  <Sections lang={lang} />
</Base>
