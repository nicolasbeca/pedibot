---
import Base from '../../layouts/Base.astro';
import DoseCalc from '../../components/DoseCalc.astro';
import Ors from '../../components/Ors.astro';
import DoseBrands from '../../components/DoseBrands.astro';
import { t } from '../../i18n';
import { genericNames } from '../../dosepages';
const lang = 'ru'; const s = t(lang);
// `Drug` hereda de Product en schema.org, así que Google lo trataba como mercancía y
// exigía offers/review/aggregateRating de un jarabe infantil. `Substance` dice lo mismo
// sin pasar por Product. Y son dos medicamentos, no uno con el nombre en inglés.
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: s.dosepage_name, about: genericNames(lang).map((n) => ({ '@type': 'Substance', name: n })), audience: { '@type': 'Patient' } };
---
<Base lang={lang} title={s.dosepage_title} description={s.dosepage_desc} path="/ru/dose" jsonld={jsonld}>
  <div class="wrap" style="padding-top:40px">
    <p class="eyebrow">{s.dose_eyebrow}</p>
    <h1 style="margin-top:8px">{s.dose_h2}</h1>
    <p class="lede">{s.dose_lede}</p>
    <DoseCalc lang={lang} />
    <Ors lang={lang} />
    <DoseBrands lang={lang} />
    <section class="block" style="padding-top:48px">
      <h2>{s.dose_why_h}</h2>
      <p class="lede">{s.dose_why_p}</p>
    </section>
  </div>
</Base>
