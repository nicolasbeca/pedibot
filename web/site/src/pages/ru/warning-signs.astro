---
import Base from '../../layouts/Base.astro';
import WarningSigns from '../../components/WarningSigns.astro';
import { t } from '../../i18n';
const lang = 'ru'; const s = t(lang) as any;
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: s.ws_h1, about: s.emg_about };
---
<Base lang={lang} title={s.ws_title} description={s.ws_desc} path="/ru/warning-signs" jsonld={jsonld}>
  <div class="wrap" style="padding:40px 18px">
    <p class="eyebrow">{s.ws_eyebrow}</p>
    <h1 style="margin-top:8px">{s.ws_h1}</h1>
    <p class="lede">{s.ws_lede}</p>
    <WarningSigns lang={lang} />
  </div>
</Base>
