---
import Base from '../../layouts/Base.astro';
import Growth from '../../components/Growth.astro';
import CountryLinks from '../../components/CountryLinks.astro';
import { t } from '../../i18n';
import charts from '../../data/growth_charts.json';
const lang = 'ru'; const s = t(lang);
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: s.growthpage_name, about: { '@type': 'MedicalTest', name: 'WHO child growth standards' }, audience: { '@type': 'Patient' } };
---
<Base lang={lang} title={s.growthpage_title} description={s.growthpage_desc} path="/ru/growth" jsonld={jsonld}>
  <div class="wrap" style="padding-top:40px">
    <p class="eyebrow">{s.nav_growth}</p>
    <Growth lang={lang} />
    <CountryLinks lang={lang} codes={Object.keys(charts as any)} base="/growth" title={s.growthc_by_country} />
  </div>
</Base>
