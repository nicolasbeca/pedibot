---
import Base from '../../layouts/Base.astro';
import DoseCalc from '../../components/DoseCalc.astro';
import Ors from '../../components/Ors.astro';
import DoseBrands from '../../components/DoseBrands.astro';
import { t } from '../../i18n';
const lang = 'hi'; const s = t(lang);
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: s.dosepage_name, about: { '@type': 'Drug', name: 'Paracetamol, ibuprofen' }, audience: { '@type': 'Patient' } };
---
<Base lang={lang} title={s.dosepage_title} description={s.dosepage_desc} path="/hi/dose" jsonld={jsonld}>
  <div class="wrap" style="padding-top:40px">
    <p class="eyebrow">{s.dose_eyebrow}</p>
    <h1 style="margin-top:8px">{s.dose_h2}</h1>
    <p class="lede">{s.dose_lede}</p>
    <DoseCalc lang={lang} />
    <Ors lang={lang} />
    <DoseBrands lang={lang} />
    <section class="block" style="padding-top:48px">
      <h2>{s.dose_why_h}</h2>
      <p class="lede">{s.dose_why_p}</p>
    </section>
  </div>
</Base>
