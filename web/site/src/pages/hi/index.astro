---
import Base from '../../layouts/Base.astro';
import Chat from '../../components/Chat.astro';
import Alerts from '../../components/Alerts.astro';
import PopularGuides from '../../components/PopularGuides.astro';
import Sections from '../../components/Sections.astro';
import { t } from '../../i18n';
const lang = 'hi';
const s = t(lang);
const jsonld = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'PediBot', applicationCategory: 'HealthApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0' }, description: s.meta_home_desc };
---
<Base lang={lang} title={s.meta_home_title} description={s.meta_home_desc} path="/pt" jsonld={jsonld}>
  <Chat lang={lang} />
  <Alerts lang={lang} />
  <PopularGuides lang={lang} />
  <Sections lang={lang} />
</Base>
