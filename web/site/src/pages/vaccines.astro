---
import schedules from '../data/vaccines.json';
import Base from '../layouts/Base.astro';
import VaccinesTool from '../components/VaccinesTool.astro';
import { t, langPrefix } from '../i18n';
const lang = 'en'; const s = t(lang); const p = langPrefix(lang);
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: s.vaxpage_name, about: s.vaxpage_about };
---
<Base lang={lang} title={s.vaxpage_title} description={s.vaxpage_desc} path="/vaccines" jsonld={jsonld}>
  <div class="wrap" style="padding:40px 18px">
    <p class="eyebrow">{s.nav_vaccines}</p>
    <VaccinesTool lang={lang} />
    <p class="n" style="margin-top:26px">{s.vax_full_by_country} {Object.entries(schedules).map(([c, d]) => (
      <a href={`${p}/vaccines/${c.toLowerCase()}`} style="margin-inline-end:10px">{d.name?.[lang] ?? d.name?.en ?? c}</a>
    ))}</p>
  </div>
</Base>
