---
import Base from '../../../layouts/Base.astro';
import drugs from '../../../data/drugs.json';
export async function getStaticPaths() {
  const out: any[] = [];
  const weights = Array.from({ length: 36 }, (_, i) => i + 5);
  for (const [key, d] of Object.entries(drugs as any)) {
    const entries = [{ slug: key === 'ibuprofen' ? 'ibuprofeno' : key, name: (d as any).generic.es, forms: (d as any).presentations.map((p: any) => ({ label: p.name, mg_per_ml: p.mg_per_ml })), brand: null }]
      .concat((d as any).brands.filter((b: any) => b.forms.length).map((b: any) => ({ slug: b.slug, name: b.name, forms: b.forms, brand: b.name })));
    for (const e of entries) for (const kg of weights) out.push({ params: { slug: `${e.slug}-${kg}kg` }, props: { key, d, e, kg } });
  }
  return out;
}
const { key, d, e, kg } = Astro.props as any;
const [lo, hi] = d.per_dose_mg_per_kg;
let mgMin = lo * kg, mgMax = Math.min(hi * kg, d.max_single_mg); mgMin = Math.min(mgMin, mgMax);
const dailyCap = Math.min(d.max_mg_per_kg_day * kg, d.max_daily_mg);
const maxDoses = Math.max(1, Math.min(Math.floor(dailyCap / mgMax), Math.floor(24 / d.interval_hours[0])));
const r1 = (x: number) => Math.round(x * 10) / 10;
const title = `Dosis de ${e.name} para un niño de ${kg} kg`;
const desc = `${e.name} para ${kg} kg: ${Math.round(mgMin)}–${Math.round(mgMax)} mg cada ${d.interval_hours[0]}–${d.interval_hours[1]} horas, en ml según la concentración del envase. Guía de dosificación AEPap. No es consejo médico.`;
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, about: { '@type': 'Drug', name: e.name }, audience: { '@type': 'Patient' } };
const isIbu = key === 'ibuprofen';
---
<Base lang="es" title={`${title} — PediBot`} description={desc} path={`/es/dose/${e.slug}-${kg}kg`} jsonld={jsonld}>
  <div class="narrow" style="padding:40px 18px">
    <p class="eyebrow">Calculadora de dosis · {d.generic.es}</p>
    <h1 style="margin-top:8px">{title}</h1>
    <p class="lede">Tabla fija de la guía de dosificación de la AEPap — sin IA. Comprueba siempre la concentración impresa en el envase.</p>
    <div class="card" style="margin-top:24px">
      <div class="big mono">{Math.round(mgMin)}–{Math.round(mgMax)} mg</div>
      <p>cada {d.interval_hours[0]}–{d.interval_hours[1]} horas · máximo {maxDoses} dosis en 24 horas</p>
      <table class="plain" style="margin-top:12px">
        <thead><tr><th>Concentración del envase</th><th>ml por dosis</th></tr></thead>
        <tbody>{e.forms.map((f: any) => <tr><td>{f.label}</td><td class="mono">{r1(mgMin / f.mg_per_ml)}–{r1(mgMax / f.mg_per_ml)} ml</td></tr>)}</tbody>
      </table>
      {kg < d.min_weight_kg && <p class="warn">⚠️ Por debajo del peso mínimo para {d.generic.es} — no dar sin indicación médica.</p>}
      <p class="warn">⚠️ Menores de 3 meses: no dar ningún medicamento sin indicación médica. {isIbu && 'El ibuprofeno no es para bebés de menos de 3 meses / 5 kg, y debe evitarse si está deshidratado (vómitos, diarrea) o tiene varicela.'}</p>
      <p class="note">{d.notes.es}</p>
      <p class="src">{d.source}.</p>
    </div>
    <p style="margin-top:22px"><a class="btn btn-primary" href="/es/dose">Abrir la calculadora</a> <a class="btn btn-ghost" href={`/es?q=${encodeURIComponent('¿Cuánto ' + e.name + ' para ' + kg + ' kg?')}`}>Pregunta a PediBot</a></p>
    <p class="n" style="margin-top:22px">Otros pesos: {[kg - 2, kg - 1, kg + 1, kg + 2].filter(w => w >= 5 && w <= 40).map(w => <a href={`/es/dose/${e.slug}-${w}kg`} style="margin-right:8px">{w} kg</a>)}</p>
  </div>
  <style>
    .big { font-size: 2rem; color: var(--sage-deep); }
    :global(:root.night) .big { color: var(--sage); }
    .warn { background: var(--amber-soft); border-left: 4px solid var(--amber); border-radius: 10px; padding: 10px 12px; margin-top: 12px; font-size: .92rem; }
    .note { background: var(--sky); border-radius: 10px; padding: 10px 12px; margin-top: 12px; font-size: .92rem; }
    .src { font-size: .8rem; color: var(--ink-3); margin-top: 12px; }
  </style>
</Base>
