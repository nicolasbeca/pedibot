---
// Una página por medicamento con la tabla completa de pesos (2-sep-2026). Sustituye a 1.442
// páginas de un solo peso: el motivo, medido, está en src/dosepages.ts.
import Base from '../../../layouts/Base.astro';
import { medicines, weightTable, maxDoses, type Medicine } from '../../../dosepages';

export async function getStaticPaths() {
  return medicines().map((m) => ({ params: { slug: m.slug_es }, props: { m } }));
}

const { m } = Astro.props as { m: Medicine };
const rows = weightTable(m);
const d = m.d;
const isIbu = m.key === 'ibuprofen';
const title = `Dosis de ${m.name_es} por peso`;
const desc = `${m.name_es} en niños: la dosis en mg y en ml para cada peso de 5 a 40 kg y para cada concentración del envase. Tabla fija de la guía de dosificación de la AEPap. No es consejo médico.`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: title,
  about: { '@type': 'Drug', name: m.name_es, activeIngredient: d.generic.es },
  audience: { '@type': 'Patient' },
};
---
<Base lang="es" title={`${title} — PediBot`} description={desc} path={`/es/dose/${m.slug_es}`} jsonld={jsonld}>
  <div class="narrow" style="padding:40px 18px">
    <p class="eyebrow">Calculadora de dosis · {d.generic.es}</p>
    <h1 style="margin-top:8px">{title}</h1>
    <p class="lede">
      Cada peso de 5 a 40 kg, en miligramos y en mililitros según la concentración del envase.
      Tabla fija de la guía de dosificación de la AEPap — sin IA. Comprueba siempre la
      concentración impresa en tu envase: cambia según el país y la presentación.
    </p>

    <div class="card" style="margin-top:24px">
      <p><b>Cada {d.interval_hours[0]}–{d.interval_hours[1]} horas</b>, y nunca más dosis en 24
      horas que las de la última columna.</p>
      <div class="scroll">
        <table class="plain">
          <thead>
            <tr>
              <th>Peso</th>
              <th>Dosis</th>
              {m.forms.map((f) => <th>{f.label}</th>)}
              <th>Máx. / 24 h</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class={r.belowMin ? 'low' : undefined}>
                <th scope="row">{r.kg} kg</th>
                <td class="mono">{r.mgMin}–{r.mgMax} mg</td>
                {r.ml.map((v) => <td class="mono">{v} ml</td>)}
                <td class="mono">{maxDoses(m, r.kg)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="warn">⚠️ Las filas en gris están por debajo del peso mínimo para {d.generic.es}:
      no lo des sin que te lo indique un médico. Por debajo de 3 meses, ningún medicamento sin
      indicación.
      {isIbu && ' El ibuprofeno además se evita si el niño está deshidratado (vómitos, diarrea) o tiene varicela.'}</p>
      <p class="note">{d.notes.es}</p>
      <p class="src">{d.source}.</p>
    </div>

    <p style="margin-top:22px">
      <a class="btn btn-primary" href="/es/dose">Abrir la calculadora</a>
      <a class="btn btn-ghost" href={`/es/?q=${encodeURIComponent('¿Cuánto ' + m.name_es + ' le doy a mi hijo?')}`}>Preguntar a PediBot</a>
    </p>

    <p class="n" style="margin-top:26px">
      Otros medicamentos:{' '}
      {medicines().filter((o) => o.slug_es !== m.slug_es).slice(0, 8).map((o) => (
        <a href={`/es/dose/${o.slug_es}`} style="margin-right:10px">{o.name_es}</a>
      ))}
    </p>
  </div>
  <style>
    .scroll { overflow-x: auto; margin-top: 12px; }
    table.plain { width: 100%; border-collapse: collapse; font-size: .92rem; }
    table.plain th, table.plain td { padding: 6px 10px; text-align: left; white-space: nowrap; }
    table.plain thead th { border-bottom: 2px solid var(--line); font-size: .84rem; }
    table.plain tbody tr { border-bottom: 1px solid var(--line); }
    table.plain tbody tr.low { color: var(--ink-3); background: var(--cream); }
    .warn { background: var(--amber-soft); border-left: 4px solid var(--amber); border-radius: 10px; padding: 10px 12px; margin-top: 14px; font-size: .92rem; }
    .note { background: var(--sky); border-radius: 10px; padding: 10px 12px; margin-top: 12px; font-size: .92rem; }
    .src { font-size: .8rem; color: var(--ink-3); margin-top: 12px; }
  </style>
</Base>
