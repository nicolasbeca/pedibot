---
import Base from '../../layouts/Base.astro';
import Diary from '../../components/Diary.astro';
import { t } from '../../i18n';
const lang = 'es'; const s = t(lang);
---
<Base lang={lang} title={s.diary_title} description={s.diary_desc} path="/es/diary">
  <div class="narrow" style="padding:40px 18px"><Diary lang={lang} /></div>
</Base>
