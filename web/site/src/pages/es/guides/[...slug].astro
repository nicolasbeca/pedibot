---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { t } from '../../../i18n';
export async function getStaticPaths() {
  const guides = await getCollection('guides', g => g.data.lang === 'es' && !g.data.draft);
  return guides.map(g => ({ params: { slug: g.id.replace(/^es\//, '') }, props: { g } }));
}
const { g } = Astro.props; const lang = 'es'; const s = t(lang);
const { Content } = await render(g);
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', headline: g.data.title, description: g.data.description, datePublished: g.data.date.toISOString(), inLanguage: 'es', author: { '@type': 'Organization', name: 'PediBot' }, citation: g.data.sources };
---
<Base lang={lang} title={`${g.data.title} — PediBot`} description={g.data.description} path={`/es/guides/${g.id.replace(/^es\//, '')}`} jsonld={jsonld}>
  <article class="narrow prose" style="padding:40px 18px">
    <p class="eyebrow">{g.data.topic} · {s.updated} <time datetime={g.data.date.toISOString()}>{g.data.date.toLocaleDateString('es-ES')}</time></p>
    <h1 style="margin-top:8px">{g.data.title}</h1>
    <p class="lede">{g.data.description}</p>
    <Content />
    <p style="margin-top:32px"><a class="btn btn-primary" href={`/es?q=${encodeURIComponent(g.data.title)}`}>{s.ask_about} →</a></p>
  </article>
</Base>
