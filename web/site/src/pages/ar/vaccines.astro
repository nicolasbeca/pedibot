---
import schedules from '../../data/vaccines.json';
import Base from '../../layouts/Base.astro';
import VaccinesTool from '../../components/VaccinesTool.astro';
import CountryLinks from '../../components/CountryLinks.astro';
import { t } from '../../i18n';
const lang = 'ar'; const s = t(lang);
// counted, never typed: this sentence used to name five countries and there are
// seven. See the same fix for {langs} on the support page.
const countryCount = String(Object.keys(schedules).length);
const fillCountries = (x: string) => x.replace(/\{countries\}/g, countryCount);
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: s.vaxpage_name, about: s.vaxpage_about };
---
<Base lang={lang} title={s.vaxpage_title} description={fillCountries(s.vaxpage_desc)} path="/ar/vaccines" jsonld={jsonld}>
  <div class="wrap" style="padding:40px 18px">
    <p class="eyebrow">{s.nav_vaccines}</p>
    <VaccinesTool lang={lang} />
    <CountryLinks lang={lang} codes={Object.keys(schedules)} base="/vaccines" title={s.vax_full_by_country} />
  </div>
</Base>
