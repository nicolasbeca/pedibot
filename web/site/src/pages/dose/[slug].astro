---
// One page per medicine with the full weight table (2-sep-2026). It replaces 1,442 pages of one
// weight each: see src/dosepages.ts for what was measured before deciding.
import Base from '../../layouts/Base.astro';
import { medicines, weightTable, maxDoses, type Medicine } from '../../dosepages';

export async function getStaticPaths() {
  return medicines().map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props as { m: Medicine };
const rows = weightTable(m);
const d = m.d;
const isIbu = m.key === 'ibuprofen';
const title = `${m.name_en} dose by weight`;
const desc = `${m.name_en} for children: the dose in mg and in ml for every weight from 5 to 40 kg, for each bottle strength sold. Fixed table from the AEPap dosing guide. Not medical advice.`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: title,
  about: { '@type': 'Drug', name: m.name_en, activeIngredient: d.generic.en },
  audience: { '@type': 'Patient' },
};
---
<Base lang="en" title={`${title} — PediBot`} description={desc} path={`/dose/${m.slug}`} jsonld={jsonld}>
  <div class="narrow" style="padding:40px 18px">
    <p class="eyebrow">Dose calculator · {d.generic.en}</p>
    <h1 style="margin-top:8px">{title}</h1>
    <p class="lede">
      Every weight from 5 to 40 kg, in milligrams and in millilitres for each bottle strength.
      A fixed table from the AEPap dosing guide — no AI involved. Always check the strength
      printed on your own bottle, because it varies by country and by presentation.
    </p>

    <div class="card" style="margin-top:24px">
      <p><b>Every {d.interval_hours[0]}–{d.interval_hours[1]} hours</b>, and never more than the
      doses in the last column in 24 hours.</p>
      <div class="scroll">
        <table class="plain">
          <thead>
            <tr>
              <th>Weight</th>
              <th>Dose</th>
              {m.forms.map((f) => <th>{f.label}</th>)}
              <th>Max / 24 h</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class={r.belowMin ? 'low' : undefined}>
                <th scope="row">{r.kg} kg</th>
                <td class="mono">{r.mgMin}–{r.mgMax} mg</td>
                {r.ml.map((v) => <td class="mono">{v} ml</td>)}
                <td class="mono">{maxDoses(m, r.kg)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="warn">⚠️ Rows in grey are below the minimum weight for {d.generic.en}: do not give
      it without a doctor's advice. Under 3 months, no medicine at all without being told to.
      {isIbu && ' Ibuprofen is also avoided when the child is dehydrated (vomiting, diarrhoea) or has chickenpox.'}</p>
      <p class="note">{d.notes.en}</p>
      <p class="src">{d.source}.</p>
    </div>

    <p style="margin-top:22px">
      <a class="btn btn-primary" href="/dose">Open the calculator</a>
      <a class="btn btn-ghost" href={`/?q=${encodeURIComponent('How much ' + m.name_en + ' for my child?')}`}>Ask PediBot</a>
    </p>

    <p class="n" style="margin-top:26px">
      Other medicines:{' '}
      {medicines().filter((o) => o.slug !== m.slug).slice(0, 8).map((o) => (
        <a href={`/dose/${o.slug}`} style="margin-right:10px">{o.name_en}</a>
      ))}
    </p>
  </div>
  <style>
    .scroll { overflow-x: auto; margin-top: 12px; }
    table.plain { width: 100%; border-collapse: collapse; font-size: .92rem; }
    table.plain th, table.plain td { padding: 6px 10px; text-align: left; white-space: nowrap; }
    table.plain thead th { border-bottom: 2px solid var(--line); font-size: .84rem; }
    table.plain tbody tr { border-bottom: 1px solid var(--line); }
    table.plain tbody tr.low { color: var(--ink-3); background: var(--cream); }
    .warn { background: var(--amber-soft); border-left: 4px solid var(--amber); border-radius: 10px; padding: 10px 12px; margin-top: 14px; font-size: .92rem; }
    .note { background: var(--sky); border-radius: 10px; padding: 10px 12px; margin-top: 12px; font-size: .92rem; }
    .src { font-size: .8rem; color: var(--ink-3); margin-top: 12px; }
  </style>
</Base>
