---
// I-29: one static page per brand × weight, e.g. /dose/calpol-14kg — the search parents actually type.
import Base from '../../layouts/Base.astro';
import drugs from '../../data/drugs.json';
export async function getStaticPaths() {
  const out: any[] = [];
  const weights = Array.from({ length: 36 }, (_, i) => i + 5); // 5–40 kg
  for (const [key, d] of Object.entries(drugs as any)) {
    const entries = [{ slug: key, name: (d as any).generic.en, forms: (d as any).presentations.map((p: any) => ({ label: p.name, mg_per_ml: p.mg_per_ml })), brand: null }]
      .concat((d as any).brands.filter((b: any) => b.forms.length).map((b: any) => ({ slug: b.slug, name: b.name, forms: b.forms, brand: b.name })));
    for (const e of entries) for (const kg of weights) out.push({ params: { slug: `${e.slug}-${kg}kg` }, props: { key, d, e, kg } });
  }
  return out;
}
const { key, d, e, kg } = Astro.props as any;
const [lo, hi] = d.per_dose_mg_per_kg;
let mgMin = lo * kg, mgMax = Math.min(hi * kg, d.max_single_mg); mgMin = Math.min(mgMin, mgMax);
const dailyCap = Math.min(d.max_mg_per_kg_day * kg, d.max_daily_mg);
const maxDoses = Math.max(1, Math.min(Math.floor(dailyCap / mgMax), Math.floor(24 / d.interval_hours[0])));
const r1 = (x: number) => Math.round(x * 10) / 10;
const title = `${e.name} dose for a ${kg} kg child`;
const desc = `${e.name} for ${kg} kg: ${Math.round(mgMin)}–${Math.round(mgMax)} mg every ${d.interval_hours[0]}–${d.interval_hours[1]} hours, in ml for each bottle strength. From the AEPap dosing guide. Not medical advice.`;
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: title, about: { '@type': 'Drug', name: e.name }, audience: { '@type': 'Patient' } };
const isIbu = key === 'ibuprofen';
---
<Base lang="en" title={`${title} — PediBot`} description={desc} path={`/dose/${e.slug}-${kg}kg`} jsonld={jsonld}>
  <div class="narrow" style="padding:40px 18px">
    <p class="eyebrow">Dose calculator · {d.generic.en}</p>
    <h1 style="margin-top:8px">{title}</h1>
    <p class="lede">Fixed table from the AEPap dosing guide — no AI involved. Always check the strength printed on your bottle.</p>
    <div class="card" style="margin-top:24px">
      <div class="big mono">{Math.round(mgMin)}–{Math.round(mgMax)} mg</div>
      <p>every {d.interval_hours[0]}–{d.interval_hours[1]} hours · at most {maxDoses} doses in 24 hours</p>
      <table class="plain" style="margin-top:12px">
        <thead><tr><th>Bottle strength</th><th>ml per dose</th></tr></thead>
        <tbody>{e.forms.map((f: any) => <tr><td>{f.label}</td><td class="mono">{r1(mgMin / f.mg_per_ml)}–{r1(mgMax / f.mg_per_ml)} ml</td></tr>)}</tbody>
      </table>
      {kg < d.min_weight_kg && <p class="warn">⚠️ Below the minimum weight for {d.generic.en} — do not give without a doctor's advice.</p>}
      <p class="warn">⚠️ Under 3 months: do not give any medicine without a doctor's advice. {isIbu && 'Ibuprofen is not for babies under 3 months / 5 kg, and should be avoided if the child is dehydrated (vomiting, diarrhoea) or has chickenpox.'}</p>
      <p class="note">{d.notes.en}</p>
      <p class="src">{d.source}.</p>
    </div>
    <p style="margin-top:22px"><a class="btn btn-primary" href="/dose">Open the calculator</a> <a class="btn btn-ghost" href={`/?q=${encodeURIComponent('How much ' + e.name + ' for ' + kg + ' kg?')}`}>Ask PediBot</a></p>
    <p class="n" style="margin-top:22px">Other weights: {[kg - 2, kg - 1, kg + 1, kg + 2].filter(w => w >= 5 && w <= 40).map(w => <a href={`/dose/${e.slug}-${w}kg`} style="margin-right:8px">{w} kg</a>)}</p>
  </div>
  <style>
    .big { font-size: 2rem; color: var(--sage-deep); }
    :global(:root.night) .big { color: var(--sage); }
    .warn { background: var(--amber-soft); border-left: 4px solid var(--amber); border-radius: 10px; padding: 10px 12px; margin-top: 12px; font-size: .92rem; }
    .note { background: var(--sky); border-radius: 10px; padding: 10px 12px; margin-top: 12px; font-size: .92rem; }
    .src { font-size: .8rem; color: var(--ink-3); margin-top: 12px; }
  </style>
</Base>
