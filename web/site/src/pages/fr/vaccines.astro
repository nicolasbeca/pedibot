---
import schedules from '../../data/vaccines.json';
import Base from '../../layouts/Base.astro';
import VaccinesTool from '../../components/VaccinesTool.astro';
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', name: 'Calendario de vacunas infantil por país y edad', about: 'Calendarios de vacunación (España, Reino Unido, EE. UU.)' };
---
<Base lang="fr" title="Calendario de vacunas infantil por país y edad — PediBot" description="Quels vaccins sont prévus à chaque âge en France, en Allemagne, en Espagne, au Royaume-Uni et aux États-Unis, transcrits des calendriers officiels. Sans IA." path="/fr/vaccines" jsonld={jsonld}>
  <div class="wrap" style="padding:40px 18px"><p class="eyebrow">Vacunas</p><VaccinesTool lang="fr" /><p class="n" style="margin-top:26px">Calendrier complet par pays : {Object.entries(schedules).map(([c, d]) => (<a href={`/fr/vaccines/${c.toLowerCase()}`} style="margin-right:10px">{d.name?.['es'] ?? c}</a>))}</p></div>
</Base>
