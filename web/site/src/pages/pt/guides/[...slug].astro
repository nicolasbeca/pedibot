---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { t } from '../../../i18n';
import { faqsFrom, relatedTo, topicKeys } from '../../../guides';
export async function getStaticPaths() {
  const guides = await getCollection('guides', g => g.data.lang === 'pt' && !g.data.draft);
  return guides.map(g => ({ params: { slug: g.id.replace(/^pt\//, '') }, props: { g } }));
}
const { g } = Astro.props; const lang = 'pt'; const s = t(lang);
// the same guide in the other languages: matched by `topic`, which is language-neutral.
// An explicit null tells the layout there is no translation yet, so it emits neither an
// hreflang nor a switch link — pointing at a page that does not exist is worse than both.
const others: Record<string, string | null> = {};
{
  const twins = await getCollection('guides', x => x.data.lang === 'en' && !x.data.draft && topicKeys(g.data.topic).includes(x.data.topic));
  others['en'] = twins.length ? `/guides/${twins[0].id.replace(/^en\//, '')}` : null;
}
{
  const twins = await getCollection('guides', x => x.data.lang === 'fr' && !x.data.draft && topicKeys(g.data.topic).includes(x.data.topic));
  others['fr'] = twins.length ? `/fr/guides/${twins[0].id.replace(/^fr\//, '')}` : null;
}
{
  const twins = await getCollection('guides', x => x.data.lang === 'de' && !x.data.draft && topicKeys(g.data.topic).includes(x.data.topic));
  others['de'] = twins.length ? `/de/guides/${twins[0].id.replace(/^de\//, '')}` : null;
}
{
  const twins = await getCollection('guides', x => x.data.lang === 'ru' && !x.data.draft && topicKeys(g.data.topic).includes(x.data.topic));
  others['ru'] = twins.length ? `/ru/guides/${twins[0].id.replace(/^ru\//, '')}` : null;
}
{
  const twins = await getCollection('guides', x => x.data.lang === 'ar' && !x.data.draft && topicKeys(g.data.topic).includes(x.data.topic));
  others['ar'] = twins.length ? `/ar/guides/${twins[0].id.replace(/^ar\//, '')}` : null;
}
{
  const twins = await getCollection('guides', x => x.data.lang === 'es' && !x.data.draft && topicKeys(g.data.topic).includes(x.data.topic));
  others['es'] = twins.length ? `/es/guides/${twins[0].id.replace(/^es\//, '')}` : null;
}
const family = await getCollection('guides', x => x.data.lang === 'pt' && !x.data.draft);
const related = relatedTo(g, family);
const faqs = faqsFrom(g.body ?? '');
const { Content } = await render(g);
const page = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', headline: g.data.title, description: g.data.description, datePublished: g.data.date.toISOString(), inLanguage: lang, author: { '@type': 'Organization', name: 'PediBot' }, citation: g.data.sources };
const faqLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
const jsonld = faqLd ? [page, faqLd] : page;
---
<Base lang={lang} title={`${g.data.title} — PediBot`} description={g.data.description} path={`/pt/guides/${g.id.replace(/^es\//, '')}`} jsonld={jsonld} others={others}>
  <article class="narrow prose" style="padding:40px 18px">
    <p class="eyebrow">{s.updated} <time datetime={g.data.date.toISOString()}>{g.data.date.toLocaleDateString(s.speech_locale)}</time></p>
    <h1 style="margin-top:8px">{g.data.title}</h1>
    <p class="lede">{g.data.description}</p>
    <Content />
    <p style="margin-top:32px"><a class="btn btn-primary" href={`/es?q=${encodeURIComponent(g.data.title)}`}>{s.ask_about} →</a></p>
    {related.length > 0 && (
      <nav class="related">
        <h2>{s.related_h}</h2>
        <ul>
          {related.map((r) => (
            <li>
              <a href={`/pt/guides/${r.id.replace(/^es\//, '')}`}>{r.data.title}</a>
              <span>{r.data.description}</span>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </article>
</Base>

<style>
  .related { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); }
  .related h2 { margin-top: 0; font-size: 1.1rem; }
  .related ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .related li { margin: 0; }
  .related a { font-weight: 600; }
  .related span { display: block; font-size: .88rem; color: var(--ink-3); }
</style>
