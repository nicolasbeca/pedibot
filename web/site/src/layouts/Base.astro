---
// Lenguas cuyas etiquetas de menú son notablemente más largas que las inglesas: el alemán
// compone palabras y el francés y el ruso son de suyo largos. Sólo cambia cuándo se
// esconden las pastillas, nunca cuáles existen (16-sep-2026).
const LABEL_LARGO = new Set(['de', 'fr', 'ru', 'pt']);
// El país que acompaña a cada lengua en las etiquetas sociales. Es lo que usa Facebook —y de
// rebote WhatsApp y Telegram— para decidir en qué idioma enseña la tarjeta.
const OG_LOCALE: Record<string, string> = {
  en: 'en_GB', es: 'es_ES', fr: 'fr_FR', de: 'de_DE',
  ru: 'ru_RU', ar: 'ar_SA', pt: 'pt_PT', hi: 'hi_IN',
};
import '../styles/global.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { t, langPrefix, dirFor, LANGS, LANG_NAMES, type Lang } from '../i18n';
interface Props { lang: Lang; title: string; description: string; path: string; jsonld?: object;
  // Guides have a different slug per language, so the page passes the real counterparts here:
  // { es: '/es/guides/…', fr: null } — an explicit null means "not translated yet", and that
  // language gets neither an hreflang nor a switch link. Omit the prop and the path is derived.
  others?: Partial<Record<Lang, string | null>>;
  // 19-sep-2026: para las páginas que son un ESTADO y no contenido — hoy sólo /offline, que
  // sirve el service worker cuando no hay red. No se indexan, no van al sitemap y el grafo de
  // enlaces no las cuenta como huérfanas, igual que ya hacía con las redirecciones.
  noindex?: boolean }
const { lang, title, description, path, jsonld, others, noindex } = Astro.props;
const s = t(lang);
/**
 * Lo que enseña un resultado de búsqueda son unos 60 caracteres de título. Medido el
 * 11-sep-2026 sobre el sitio construido: 166 de 800 páginas pasaban de ahí, y casi todas por
 * dos motivos evitables. Uno, el sufijo de marca: diez caracteres que no dicen nada que el
 * lector no vea ya en el dominio, empujando fuera del corte la parte que convence. Dos, los
 * calendarios vacunales, de hasta 86 caracteres.
 *
 * Así que si no cabe: primero se cae la marca, y si aún no cabe se corta por una pausa DEL
 * PROPIO título —dos puntos, raya, interrogación, coma—, que casi siempre deja un título mejor
 * que el original («Portugal — Programa Nacional de Vacinação (PNV 2025)»). Sólo si no hay
 * ninguna pausa utilizable se corta por el último espacio, nunca dentro de una palabra.
 *
 * Se acorta SÓLO lo que enseña el buscador. El <h1>, la tarjeta social y el marcado siguen
 * llevando el título entero.
 */
const MARCA = ' — PediBot';
const CORTE = 60;
const SUELO = 24; // por debajo de esto el recorte deja de decir nada y no compensa
function tituloBreve(t: string): string {
  if (t.length <= CORTE) return t;
  const x = t.endsWith(MARCA) ? t.slice(0, -MARCA.length) : t;
  if (x.length <= CORTE) return x;
  let mejor = '';
  for (const pausa of [': ', ' — ', ' – ', ' - ', '? ', ', ', ' : ']) {
    for (let i = x.indexOf(pausa); i !== -1; i = x.indexOf(pausa, i + 1)) {
      const trozo = (pausa === '? ' ? x.slice(0, i + 1) : x.slice(0, i)).trim();
      if (trozo.length >= SUELO && trozo.length <= CORTE && trozo.length > mejor.length) {
        mejor = trozo;
      }
    }
  }
  if (mejor) return mejor;
  const espacio = x.lastIndexOf(' ', CORTE - 3);
  return (espacio >= SUELO ? x.slice(0, espacio) : x.slice(0, CORTE - 3)) + '…';
}
const tituloDoc = tituloBreve(title);
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const otherLangs: Lang[] = LANGS.filter((l) => l !== lang);
// built from LANGS so a new language cannot be forgotten here — /de was, and the language
// switch on every German page would have pointed at /de/de/...
const PREFIXED = LANGS.filter((l) => l !== 'en').join('|');
const strip = (p: string) => p.replace(new RegExp(`^/(${PREFIXED})(?=/|$)`), '') || '/';
/** Where the same page lives in each of the other languages, or null when it does not. */
const alternates = otherLangs
  .map((l) => {
    const explicit = others?.[l];
    if (explicit === null) return null;
    const href = explicit ?? (`${langPrefix(l)}${strip(path)}`.replace(/\/$/, '') || '/');
    return { lang: l, href };
  })
  .filter((x): x is { lang: Lang; href: string } => x !== null);
const canonical = `${site}${path === '/' ? '' : path}`;
// La tarjeta que se ve al compartir el enlace, una por tipo de página y lengua (30-sep-2026,
// scripts/make-og-cards.mjs; todo en ops/TARJETAS.md). Se elige por la dirección: la primera
// parte tras la lengua. Si no hay tarjeta para ese tipo, la general de siempre.
const OG_TIPOS = new Set(['tools', 'emergency', 'warning-signs', 'dose', 'growth', 'vaccines', 'muac',
  'diary', 'family', 'kit', 'guides', 'sources', 'about']);
const tramos = path.split('/').filter(Boolean);
if (tramos[0] === lang) tramos.shift();
const ogTipo = tramos.length === 0 ? 'home'
  : tramos[0] === 'emergency' && tramos.length > 1 ? 'numbers'
  : OG_TIPOS.has(tramos[0]) ? tramos[0] : null;
const ogImage = ogTipo && existsSync(join(process.cwd(), 'public', 'og', lang, `${ogTipo}.jpg`))
  ? `${site}/og/${lang}/${ogTipo}.jpg` : `${site}/og.png`;
// x-default names the edition to serve a reader Google cannot place by language. Without it
// Google picks one on its own, and it was missing from all 571 pages. English at the root is
// this site's default; a page with no English counterpart claims none rather than lying.
// `alternates` leaves out the current language, so add it back and look the default up in
// the whole set. No ternary on the language: treating the page's own edition as one entry
// among the six is the same principle the rest of this file runs on.
const everyEdition = [{ lang, href: path }, ...alternates];
const enHref = everyEdition.find((a) => a.lang === 'en')?.href ?? null;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'PediBot', url: site, logo: `${site}/logo.png`, email: 'pedibot.ai@gmail.com', sameAs: ['https://x.com/pedibotai', 'https://github.com/nicolasbeca/pedibot', 'https://doi.org/10.5281/zenodo.22932517', 'https://huggingface.co/datasets/PediBot/pedibot-sources'] };
---
<html lang={lang} dir={dirFor(lang)}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>{tituloDoc}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={lang} href={canonical} />
  {enHref !== null && (
    <link rel="alternate" hreflang="x-default" href={`${site}${enHref === '/' ? '' : enHref}`} />
  )}
  {alternates.map((a) => (
    <link rel="alternate" hreflang={a.lang} href={`${site}${a.href === '/' ? '' : a.href}`} />
  ))}
  {/* 19-sep-2026. Hasta hoy el icono era un SVG dibujado por mí que se le parecía al logo de
      verdad pero no lo era: la cara en otro sitio, el rabo del bocadillo en otro lado. Ahora
      todos salen de LOGOS/LOGO_PEDIBOT_CARA.jpg con scripts/make_icons.py. */}
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/png" href="/logo-192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {/* 19-sep-2026, F1 del plan de APP.md: el sitio se puede instalar y funciona sin cobertura
      para lo que ya se abrió y para los números de emergencia. El color de tema es el menta
      del logo, que es lo que pinta Android alrededor de la ventana. */}
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#A9DED2" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="PediBot" />
  <link rel="alternate" type="application/rss+xml" title="PediBot guides" href={`${langPrefix(lang)}/rss.xml`} />
  {/* The map written for the assistants that answer questions from the web. It was
      orphaned — mentioned only in a robots.txt COMMENT, which no crawler reads — and in
      thirty days not one of them had ever fetched it. */}
  <link rel="alternate" type="text/plain" title="PediBot for language models" href="/llms.txt" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:site_name" content="PediBot" />
  <meta property="og:locale" content={OG_LOCALE[lang] ?? 'en_GB'} />
  {/* 17-sep-2026. X no pinta la tarjeta grande por deducción: hay que pedírsela por su nombre.
      Sin esta línea, un enlace a pedibot.xyz salía como un renglón azul, mientras que el mismo
      enlace en las cuentas que sí la declaran sale con imagen, título y descripción ocupando el
      ancho del tuit. La imagen ya estaba y ya medía 1200×630, que es lo que pide el formato;
      faltaba decir cuál de las dos tarjetas queremos. Lo vio el operador comparando con Regime. */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@pedibotai" />
  <meta name="twitter:creator" content="@pedibotai" />
  <meta name="generator" content={Astro.generator} />
  <meta name="virtual-protocol-site-verification" content="2e15ae48f7b5e83eda0e6748181645d4" />
  {/* Las tipografías se sirven desde aquí desde el 6-sep-2026. Antes venían de
      fonts.googleapis.com, que recibía la IP y el navegador de cada lector antes de que la página
      se pintara — y esta web promete «sin rastreadores de terceros» en su pie y en /legal. Google
      Fonts no es un rastreador publicitario, pero sí es un tercero que el lector no eligió, y el
      mayor público de esta web en Google es Alemania, donde un tribunal de Múnich declaró en 2022
      que incrustarlo sin consentimiento vulnera el RGPD por esa transmisión.

      Las cuatro familias son SIL Open Font License, que permite alojarlas. El fichero conserva
      los unicode-range de Google intactos: por eso un lector en español no se descarga el árabe
      ni el devanagari, y el peso real por visita sigue siendo de decenas de KB. Incluye el árabe,
      que ninguna de las otras tres cubre. */}
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <script is:inline>try{if(localStorage.getItem('pedibot_theme')==='night')document.documentElement.classList.add('night')}catch(e){}</script>
  {/* Modo app (1-oct-2026, appgoogle.md §3): la app de Android abre la web con ?source=android.
      sessionStorage y no localStorage, porque Chrome comparte el almacenamiento entre la app y
      el navegador y el modo app se colaría en la web normal. */}
  <script is:inline>try{var s=sessionStorage;if(location.search.indexOf('source=android')>=0||document.referrer.indexOf('android-app://xyz.pedibot.app')===0)s.setItem('pb-app','android');if(s.getItem('pb-app'))document.documentElement.classList.add('in-app')}catch(e){}</script>
  <!-- del equipo (abrió /admin): se avisa, y ni su sesión ni su IP salen en el panel como lector -->
  <script is:inline>try{if(localStorage.getItem('pedibot_team'))fetch('/api/team',{method:'POST',keepalive:true,headers:{'content-type':'application/json','x-pedibot-client':'test'},body:JSON.stringify({session:localStorage.getItem('pedibot_session')})})}catch(e){}</script>
</head>
<body>
  <header class={`bar${LABEL_LARGO.has(lang) ? " larga" : ""}`}>
    <div class="wrap bar-in">
      <a class="brand" href={langPrefix(lang) || '/'} aria-label="pedibot">
        <img src="/logo-72.png" width="34" height="34" alt="" />
        <span class="hide-xs">pedibot</span>
      </a>
      {/* 30-sep-2026, operador: «no entiendo tener duplicadas herramientas en el menú superior y
          en el desplegable», y el desplegable con barra de desplazamiento «es incomodísimo».
          La barra se queda en tres zonas: la marca, en el centro lo principal —Herramientas,
          Guías y «¿Voy a urgencias?», la única herramienta que un padre asustado no debe tener
          que buscar— y a la derecha lo de servicio, con el menú en la esquina. Las herramientas
          viven en /tools y en el panel del menú, no repartidas por la barra. */}
      <nav class="mid" aria-label={s.tools.nav}>
        <a class="pill hide-sm" href={`${langPrefix(lang)}/tools`} aria-current={path.endsWith('/tools') ? 'page' : undefined}>{s.tools.nav}</a>
        <a class="pill hide-sm" href={`${langPrefix(lang)}/guides`}>{s.nav_guides}</a>
        <a class="pill pill-er" href={`${langPrefix(lang)}/emergency`}>{s.nav_emergency_short}</a>
      </nav>
      <div class="bar-end">
        {/* in the right-hand group and not in <nav>, because this is the page that asks for help:
            it has to survive on a small screen */}
        <a class="pill pill-support" href={`${langPrefix(lang)}/support`}>♥ <span class="hide-xs">{s.nav_support}</span></a>
        {/* a menu, not one pill per language: its width no longer grows with the language
            list, and <details> means it opens with no JavaScript and answers the keyboard */}
        {/* Sin hermanas no hay menú, sólo la etiqueta. Tres guías del sitio existen únicamente
            en inglés a propósito —en castellano serían un duplicado de otra que ya hay— y en
            ellas el desplegable se abría para ofrecerse a sí mismo: el lector pulsa y no hay
            nada. Un menú que se abre vacío es peor que no tener menú (11-sep-2026). */}
        {alternates.length === 0 ? (
          <span class="pill langsel-solo" aria-label={s.lang_label}>{lang.toUpperCase()}</span>
        ) : (
          <details class="langsel">
            <summary class="pill" aria-label={s.lang_label}>{lang.toUpperCase()}<span class="caret" aria-hidden="true">▾</span></summary>
            <ul>
              <li><span class="cur" aria-current="true">{LANG_NAMES[lang]}</span></li>
              {alternates.map((a) => (
                <li><a href={a.href} hreflang={a.lang}>{LANG_NAMES[a.lang]}</a></li>
              ))}
            </ul>
          </details>
        )}
        <button class="pill" id="theme" type="button" aria-label="Night mode">🌙</button>
        {/* El menú con TODO, en un panel ancho de tres columnas sin barra de desplazamiento
            (30-sep-2026). Sigue siendo un <details>: se abre sin JavaScript y con el teclado. */}
        <details class="navmenu">
          <summary class="pill" aria-label={s.nav_menu}><span aria-hidden="true">☰</span> <span class="hide-xs">{s.nav_menu}</span></summary>
          <div class="panel">
            <div class="pcol urgent">
              <p class="ph">{s.tools.p_urgent}</p>
              <a href={`${langPrefix(lang)}/emergency`}>{s.nav_emergency}<small>{s.tools.t_er}</small></a>
              <a href={`${langPrefix(lang)}/warning-signs`}>{s.ws_eyebrow}<small>{s.tools.t_signs}</small></a>
              <a href={`${langPrefix(lang)}/emergency#by-country`}>{s.tools.numbers}<small>{s.tools.t_numbers}</small></a>
            </div>
            <div class="pcol">
              <p class="ph">{s.tools.p_tools}</p>
              <a href={`${langPrefix(lang) || ''}/#composer`}>{s.tools.ask}<small>{s.tools.ask_tip}</small></a>
              <a href={`${langPrefix(lang)}/dose`}>{s.nav_dose}<small>{s.tools.t_dose}</small></a>
              <a href={`${langPrefix(lang)}/growth`}>{s.nav_growth}<small>{s.tools.t_growth}</small></a>
              <a href={`${langPrefix(lang)}/vaccines`}>{s.nav_vaccines}<small>{s.tools.t_vax}</small></a>
              <a href={`${langPrefix(lang)}/muac`}>{s.muac.h}<small>{s.tools.t_muac}</small></a>
              <a href={`${langPrefix(lang)}/diary`}>{s.nav_diary}<small>{s.tools.t_diary}</small></a>
              <a href={`${langPrefix(lang)}/family`}>{s.fam.h1}<small>{s.tools.t_kids}</small></a>
              <a class="all" href={`${langPrefix(lang)}/tools`}>{s.tools.all} →</a>
            </div>
            <div class="pcol">
              <p class="ph">{s.tools.p_more}</p>
              <a href={`${langPrefix(lang)}/guides`}>{s.nav_guides}<small>{s.tools.t_guides}</small></a>
              <a href={`${langPrefix(lang)}/kit`}>{s.nav_kit}<small>{s.tools.t_home}</small></a>
              <a href={`${langPrefix(lang)}/sources`}>{s.nav_sources}<small>{s.tools.t_sources}</small></a>
              <a href={`${langPrefix(lang)}/about`}>{s.about.eyebrow}<small>{s.tools.t_about}</small></a>
              <a href={`${langPrefix(lang)}/legal`}>{s.nav_legal}<small>{s.tools.t_legal}</small></a>
            </div>
          </div>
        </details>
      </div>
    </div>
  </header>
  <slot />
  <footer>
    <div class="wrap">
      <b style="font-family:Nunito,sans-serif;color:var(--ink)">pedibot</b> · pedibot.ai@gmail.com · <a href="https://t.me/Pedichat_bot">Telegram</a> · <a href="https://x.com/pedibotai" rel="me">@pedibotai</a> · <a href="https://bsky.app/profile/pedibot.bsky.social" rel="me">Bluesky</a> ·
      {/* 19-sep-2026, lo preguntó el operador leyendo su propio pie: «¿qué es eso de
          llms.txt?». Si lo pregunta él, un padre ni lo pregunta. Es un mapa del sitio escrito
          para los asistentes que contestan preguntas de salud —ChatGPT, Claude, Perplexity—,
          con las tres reglas del proyecto y las direcciones que pueden citar. **Sigue
          existiendo y sigue sirviéndose**: lo que se quita es el enlace del pie, que es para
          humanos. Las máquinas lo encuentran por el <link rel="alternate"> de la cabecera, que
          es donde miran, y por robots.txt. */}
      <a href={`${langPrefix(lang)}/tools`}>{s.tools.nav}</a> · <a href={`${langPrefix(lang)}/sources`}>{s.nav_sources}</a> · <a href={`${langPrefix(lang)}/guides`}>{s.nav_guides}</a> · <a href={`${langPrefix(lang)}/dose`}>{s.nav_dose}</a> · <a href={`${langPrefix(lang)}/kit`}>{s.nav_kit}</a> · <a href={`${langPrefix(lang)}/emergency`}>{s.nav_emergency}</a> · <a href={`${langPrefix(lang)}/warning-signs`}>{s.ws_eyebrow}</a> · <a href={`${langPrefix(lang)}/diary`}>{s.nav_diary}</a> · <a href={`${langPrefix(lang)}/family`}>{s.fam.h1}</a> · <a href={`${langPrefix(lang)}/vaccines`}>{s.nav_vaccines}</a> · <a href={`${langPrefix(lang)}/growth`}>{s.nav_growth}</a> · <a href={`${langPrefix(lang)}/muac`}>{s.muac.h}</a> · <a href={`${langPrefix(lang)}/support`}>{s.nav_support}</a> · <a href={`${langPrefix(lang)}/about`}>{s.about.eyebrow}</a> · <a href={`${langPrefix(lang)}/legal`}>{s.nav_legal}</a><br />
      {s.footer_legal}
    </div>
  </footer>
  <style>
    :global(html[dir='rtl'] body) { font-family: 'Noto Sans Arabic', 'Atkinson Hyperlegible', sans-serif; }
    :global(html[dir='rtl']) h1, :global(html[dir='rtl']) h2, :global(html[dir='rtl']) h3,
    :global(html[dir='rtl']) .brand { font-family: 'Noto Sans Arabic', Nunito, sans-serif; }
    .bar { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--ground) 86%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
    .bar-in { height: 60px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; }
    .bar-in > .brand { justify-self: start; }
    .bar-end { justify-self: end; }
    .pill-er { background: var(--coral-soft); border-color: transparent; color: var(--coral); font-weight: 700; }
    .pill-er:hover { border-color: var(--coral); }
    .bar nav .pill[aria-current="page"] { background: var(--mint); border-color: var(--mint-2); color: var(--ink); font-weight: 700; }
    .brand { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--ink); font-family: Nunito, sans-serif; font-weight: 800; font-size: 1.2rem; }
    /* Lo que no cabe DESAPARECE; no se corta ni se arrastra. Con `overflow-x: auto` la barra
       alemana —«Dosisrechner», «Wachstumskurve», «Impfungen»— enseñaba la última pastilla
       partida por la mitad, que es peor que no enseñarla (visto por el operador, 16-sep-2026).
       Envolviendo y recortando a la altura de una fila, la pastilla que no entra se va a una
       segunda fila que no se ve. Todo lo que cae aquí sigue en el pie.
       El recorte va en `em` y no en píxeles: con 34 px cortaba las pastillas POR ABAJO,
       porque una pastilla mide más que eso en cuanto el lector agranda la letra. */
    .bar nav { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 8px;
               min-width: 0; max-height: 2.2em; overflow: hidden; }
    .bar nav > a { flex: 0 0 auto; }
    .bar-end { display: flex; gap: 8px; flex: 0 0 auto; }
    /* Shed links as the window narrows. Everything dropped here is still in the footer, and the
       widths are where each one starts to push the bar past the 1040 px content column. */
    @media (max-width: 1020px) { .bar .lg-only { display: none; } }
    @media (max-width: 900px) { .bar .md-only { display: none; } }
    @media (max-width: 800px) { .bar .sm-only { display: none; } }
    /* Y con etiquetas largas, antes: «Wachstumskurve» ocupa el doble que «Growth». La lengua
       se sabe al construir la página, así que no hace falta medir nada en el navegador. */
    @media (max-width: 1180px) { .bar.larga .md-only { display: none; } }
    @media (max-width: 1040px) { .bar.larga .sm-only { display: none; } }
    @media (max-width: 720px) { .bar .hide-sm { display: none; } }
    .langsel { position: relative; }
    .langsel > summary { list-style: none; user-select: none; }
    .langsel > summary::-webkit-details-marker { display: none; }
    .langsel[open] > summary { border-color: var(--sage); color: var(--ink); }
    .langsel .caret { font-size: .68em; opacity: .55; }
    .langsel > ul {
      position: absolute; inset-inline-end: 0; top: calc(100% + 7px); z-index: 30; margin: 0; padding: 6px;
      min-width: 152px; list-style: none; background: var(--paper);
      border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 12px 32px rgb(0 0 0 / 14%);
    }
    .langsel li { margin: 0; }
    .langsel a, .langsel .cur {
      display: block; padding: 8px 12px; border-radius: 9px; text-decoration: none;
      font-size: .9rem; white-space: nowrap; color: var(--ink-2);
    }
    .langsel a:hover { background: var(--mint); color: var(--ink); }
    .langsel .cur { color: var(--ink); font-weight: 700; }
    /* El menú con TODAS las secciones. Hereda la caja del selector de idiomas —es el mismo
       gesto—. Hasta el 29-sep-2026 sólo existía por debajo de 720 px; pero la barra no enseña
       todo en ningún ancho (MUAC, diario, fuentes, señales de alarma) y entre 720 y 900 px
       escondía tres pastillas sin menú que las sustituyera. Ahora está siempre. */
    .navmenu { position: relative; display: block; }
    .navmenu > summary { list-style: none; user-select: none; }
    .navmenu > summary::-webkit-details-marker { display: none; }
    .navmenu[open] > summary { border-color: var(--sage); color: var(--ink); }
    .navmenu > .panel {
      position: absolute; inset-inline-end: 0; top: calc(100% + 7px); z-index: 30;
      width: min(880px, calc(100vw - 32px)); padding: 18px; display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px 26px; background: var(--paper);
      border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 12px 32px rgb(0 0 0 / 14%);
    }
    .pcol { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .ph { margin: 0 0 4px; padding: 0 10px; font-family: Nunito, sans-serif; font-weight: 800; font-size: .74rem;
      letter-spacing: .09em; text-transform: uppercase; color: var(--ink-3); }
    .pcol.urgent .ph { color: var(--coral); }
    .navmenu .pcol a {
      display: block; padding: 8px 10px; border-radius: 12px; text-decoration: none;
      font-size: .95rem; font-weight: 700; color: var(--ink);
    }
    .navmenu .pcol a small { display: block; font-weight: 400; font-size: .8rem; line-height: 1.3; color: var(--ink-3); margin-top: 1px; }
    .navmenu .pcol a:hover { background: var(--mint); }
    .navmenu .pcol.urgent a:hover { background: var(--coral-soft); }
    .navmenu .pcol a.all { color: var(--sage); }
    /* En el teléfono: dos columnas, sin las explicaciones, y lo urgente arriba a lo ancho. Cabe
       en una pantalla sin barra de desplazamiento; el tope es sólo por si el lector agranda
       mucho la letra. */
    @media (max-width: 720px) {
      .navmenu > .panel { grid-template-columns: 1fr 1fr; gap: 10px 12px; padding: 14px; max-height: calc(100vh - 80px); overflow-y: auto; }
      .pcol.urgent { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; }
      .pcol.urgent .ph { flex-basis: 100%; }
      .navmenu .pcol a { padding: 9px 10px; font-size: .92rem; }
      .navmenu .pcol a small { display: none; }
    }
    footer { padding: 30px 0 60px; color: var(--ink-3); font-size: .86rem; border-top: 1px solid var(--line); }
    .pill-support { border-color: var(--coral-soft); color: var(--coral); }
    .pill-support:hover { background: var(--coral-soft); }
    @media (max-width: 460px) { .hide-xs { display: none; } }
  </style>
  <script>
    const root = document.documentElement, tg = document.getElementById('theme');
    const label = () => { if (tg) tg.textContent = root.classList.contains('night') ? '☀️' : '🌙'; };
    tg?.addEventListener('click', () => { root.classList.toggle('night'); try { localStorage.setItem('pedibot_theme', root.classList.contains('night') ? 'night' : 'day'); } catch (e) {} label(); });
    label();

    // a menu that only closes by clicking its own button is a trap on a phone.
    // 19-sep-2026: ahora son dos, el de idiomas y el de secciones, así que esto va por los dos
    // y además cierra uno cuando se abre el otro. Dos menús abiertos a la vez en una pantalla
    // de teléfono se tapan.
    const menus = Array.from(document.querySelectorAll('details.langsel, details.navmenu')) as HTMLDetailsElement[];
    menus.forEach((m) => m.addEventListener('toggle', () => {
      if (m.open) menus.filter((o) => o !== m && o.open).forEach((o) => { o.open = false; });
    }));
    document.addEventListener('click', (e) => {
      menus.forEach((m) => { if (m.open && !m.contains(e.target as Node)) m.open = false; });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      menus.forEach((m) => { if (m.open) { m.open = false; m.querySelector('summary')?.focus(); } });
    });
  </script>
  {/* El trabajador que hace que esto funcione sin cobertura. Va al final y dentro de `load`
      para que no le quite un milisegundo a la primera pintura, que es lo que se nota en un
      teléfono barato. Las páginas van SIEMPRE a la red primero: la copia guardada sólo
      aparece cuando la red falla (ver public/sw.js). */}
  <script is:inline>
    if ('serviceWorker' in navigator && location.protocol === 'https:') {
      addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
    }
  </script>
</body>
</html>
