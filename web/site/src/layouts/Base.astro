---
import '../styles/global.css';
import { t, langPrefix, LANGS, LANG_NAMES, type Lang } from '../i18n';
interface Props { lang: Lang; title: string; description: string; path: string; jsonld?: object;
  // Guides have a different slug per language, so the page passes the real counterparts here:
  // { es: '/es/guides/…', fr: null } — an explicit null means "not translated yet", and that
  // language gets neither an hreflang nor a switch link. Omit the prop and the path is derived.
  others?: Partial<Record<Lang, string | null>> }
const { lang, title, description, path, jsonld, others } = Astro.props;
const s = t(lang);
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const otherLangs: Lang[] = LANGS.filter((l) => l !== lang);
// built from LANGS so a new language cannot be forgotten here — /de was, and the language
// switch on every German page would have pointed at /de/de/...
const PREFIXED = LANGS.filter((l) => l !== 'en').join('|');
const strip = (p: string) => p.replace(new RegExp(`^/(${PREFIXED})(?=/|$)`), '') || '/';
/** Where the same page lives in each of the other languages, or null when it does not. */
const alternates = otherLangs
  .map((l) => {
    const explicit = others?.[l];
    if (explicit === null) return null;
    const href = explicit ?? (`${langPrefix(l)}${strip(path)}`.replace(/\/$/, '') || '/');
    return { lang: l, href };
  })
  .filter((x): x is { lang: Lang; href: string } => x !== null);
const canonical = `${site}${path === '/' ? '' : path}`;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'PediBot', url: site, logo: `${site}/logo.svg`, email: 'pedibot.ai@gmail.com', sameAs: ['https://x.com/pedibotai'] };
---
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={lang} href={canonical} />
  {alternates.map((a) => (
    <link rel="alternate" hreflang={a.lang} href={`${site}${a.href === '/' ? '' : a.href}`} />
  ))}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="PediBot guides" href={`${langPrefix(lang)}/rss.xml`} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${site}/og.png`} />
  <meta name="generator" content={Astro.generator} />
  <meta name="virtual-protocol-site-verification" content="2e15ae48f7b5e83eda0e6748181645d4" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@500;600;700;800&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400;600&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <script is:inline>try{if(localStorage.getItem('pedibot_theme')==='night')document.documentElement.classList.add('night')}catch(e){}</script>
</head>
<body>
  <header class="bar">
    <div class="wrap bar-in">
      <a class="brand" href={langPrefix(lang) || '/'}>
        <img src="/logo.svg" width="34" height="34" alt="" />
        pedibot
      </a>
      <nav class="hide-sm">
        <a class="pill lg-only" href={`${langPrefix(lang) || ''}/#how`}>{s.nav_how}</a>
        <a class="pill" href={`${langPrefix(lang)}/dose`}>{s.nav_dose}</a>
        <a class="pill" href={`${langPrefix(lang)}/guides`}>{s.nav_guides}</a>
        <a class="pill md-only" href={`${langPrefix(lang)}/sources`}>{s.nav_sources}</a>
        <a class="pill sm-only" href={`${langPrefix(lang)}/vaccines`}>{s.nav_vaccines}</a>
        <a class="pill" href={`${langPrefix(lang)}/emergency`}>{s.nav_emergency}</a>
      </nav>
      <div class="bar-end">
        {/* in the right-hand group and not in <nav>, because that one is hidden on phones and
            this is the page that asks for help: it has to survive on a small screen */}
        <a class="pill pill-support" href={`${langPrefix(lang)}/support`}>♥ <span class="hide-xs">{s.nav_support}</span></a>
        {/* a menu, not one pill per language: its width no longer grows with the language
            list, and <details> means it opens with no JavaScript and answers the keyboard */}
        <details class="langsel">
          <summary class="pill" aria-label={s.lang_label}>{lang.toUpperCase()}<span class="caret" aria-hidden="true">▾</span></summary>
          <ul>
            <li><span class="cur" aria-current="true">{LANG_NAMES[lang]}</span></li>
            {alternates.map((a) => (
              <li><a href={a.href} hreflang={a.lang}>{LANG_NAMES[a.lang]}</a></li>
            ))}
          </ul>
        </details>
        <button class="pill" id="theme" type="button" aria-label="Night mode">🌙</button>
      </div>
    </div>
  </header>
  <slot />
  <footer>
    <div class="wrap">
      <b style="font-family:Nunito,sans-serif;color:var(--ink)">pedibot</b> · pedibot.ai@gmail.com · <a href="https://t.me/Pedichat_bot">Telegram</a> · <a href="https://x.com/pedibotai" rel="me">@pedibotai</a> · <a href="https://bsky.app/profile/pedibot.bsky.social" rel="me">Bluesky</a> ·
      <a href={`${langPrefix(lang)}/sources`}>{s.nav_sources}</a> · <a href={`${langPrefix(lang)}/guides`}>{s.nav_guides}</a> · <a href={`${langPrefix(lang)}/dose`}>{s.nav_dose}</a> · <a href={`${langPrefix(lang)}/emergency`}>{s.nav_emergency}</a> · <a href={`${langPrefix(lang)}/diary`}>{s.nav_diary}</a> · <a href={`${langPrefix(lang)}/vaccines`}>{s.nav_vaccines}</a> · <a href={`${langPrefix(lang)}/support`}>{s.nav_support}</a> · <a href={`${langPrefix(lang)}/legal`}>{s.nav_legal}</a><br />
      {s.footer_legal}
    </div>
  </footer>
  <style>
    .bar { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--ground) 86%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
    .bar-in { height: 60px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .brand { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--ink); font-family: Nunito, sans-serif; font-weight: 800; font-size: 1.2rem; }
    .bar nav { display: flex; gap: 8px; min-width: 0; overflow-x: auto; scrollbar-width: none; }
    .bar nav::-webkit-scrollbar { display: none; }
    .bar nav > a { flex: 0 0 auto; }
    .bar-end { display: flex; gap: 8px; flex: 0 0 auto; }
    /* Shed links as the window narrows. Everything dropped here is still in the footer, and the
       widths are where each one starts to push the bar past the 1040 px content column. */
    @media (max-width: 1020px) { .bar .lg-only { display: none; } }
    @media (max-width: 900px) { .bar .md-only { display: none; } }
    @media (max-width: 800px) { .bar .sm-only { display: none; } }
    @media (max-width: 720px) { .bar .hide-sm { display: none; } }
    .langsel { position: relative; }
    .langsel > summary { list-style: none; user-select: none; }
    .langsel > summary::-webkit-details-marker { display: none; }
    .langsel[open] > summary { border-color: var(--sage); color: var(--ink); }
    .langsel .caret { font-size: .68em; opacity: .55; }
    .langsel > ul {
      position: absolute; right: 0; top: calc(100% + 7px); z-index: 30; margin: 0; padding: 6px;
      min-width: 152px; list-style: none; background: var(--paper);
      border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 12px 32px rgb(0 0 0 / 14%);
    }
    .langsel li { margin: 0; }
    .langsel a, .langsel .cur {
      display: block; padding: 8px 12px; border-radius: 9px; text-decoration: none;
      font-size: .9rem; white-space: nowrap; color: var(--ink-2);
    }
    .langsel a:hover { background: var(--mint); color: var(--ink); }
    .langsel .cur { color: var(--ink); font-weight: 700; }
    footer { padding: 30px 0 60px; color: var(--ink-3); font-size: .86rem; border-top: 1px solid var(--line); }
    .pill-support { border-color: var(--coral-soft); color: var(--coral); }
    .pill-support:hover { background: var(--coral-soft); }
    @media (max-width: 460px) { .hide-xs { display: none; } }
  </style>
  <script>
    const root = document.documentElement, tg = document.getElementById('theme');
    const label = () => { if (tg) tg.textContent = root.classList.contains('night') ? '☀️' : '🌙'; };
    tg?.addEventListener('click', () => { root.classList.toggle('night'); try { localStorage.setItem('pedibot_theme', root.classList.contains('night') ? 'night' : 'day'); } catch (e) {} label(); });
    label();

    // a menu that only closes by clicking its own button is a trap on a phone
    const langsel = document.querySelector('.langsel') as HTMLDetailsElement | null;
    document.addEventListener('click', (e) => {
      if (langsel?.open && !langsel.contains(e.target as Node)) langsel.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && langsel?.open) { langsel.open = false; langsel.querySelector('summary')?.focus(); }
    });
  </script>
</body>
</html>
