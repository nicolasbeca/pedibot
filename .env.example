# Copy to .env and fill in. NEVER commit .env. Every setting here is optional to start:
# with LLM_PROVIDER=fake the whole system runs without any key (see docs/INSTALL.md).

# --- Language model ---
LLM_PROVIDER=deepseek              # deepseek (any OpenAI-compatible endpoint) | fake (canned, no key)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash   # for a local model (Ollama, vLLM, llama.cpp): the model's name
DEEPSEEK_BASE_URL=https://api.deepseek.com   # e.g. http://localhost:11434/v1 for Ollama
ANTHROPIC_API_KEY=                 # unused today
MAX_DAILY_LLM_USD=2.0              # daily cap; above it the chat answers with the tools only

# --- Index / embeddings ---
INDEX_DB_PATH=index/pedibot.db
EMBEDDING_MODEL=intfloat/multilingual-e5-small   # only with the optional `embeddings` extra
RETRIEVAL_MIN_SCORE=0.35           # "source or silence" threshold (tuned on the golden set)

# --- API ---
API_HOST=127.0.0.1
API_PORT=8601
ALLOWED_ORIGINS=https://pedibot.xyz
RATE_LIMIT_PER_10MIN=20
RATE_LIMIT_PER_DAY=200
OPS_DB_PATH=data/pedibot_ops.db

# --- Telegram (alerts to the operator) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Social posting (publish --social). Bluesky + Telegram channel; X only if X_POST_ENABLED=true ---
BLUESKY_HANDLE=                    # e.g. pedibot.bsky.social
BLUESKY_APP_PASSWORD=              # Bluesky → Settings → App passwords
TELEGRAM_CHANNEL=                  # the public bot must be an admin of the channel

# --- X / Twitter (pay-per-use API) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_POST_ENABLED=false

# --- Website ---
SITE_URL=https://pedibot.xyz

# --- Public Telegram chatbot (a different bot from the alerts one) ---
TELEGRAM_PUBLIC_BOT_TOKEN=
