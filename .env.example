# Copia a .env y rellena. NUNCA commitear .env.

# --- LLM ---
LLM_PROVIDER=deepseek              # deepseek | anthropic | openai_compatible
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash   # verificado 25-ago: deepseek-v4-flash | deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=                 # respaldo opcional
MAX_DAILY_LLM_USD=2.0              # tope diario; al superarlo, modo degradado sin LLM

# --- Índice / embeddings ---
INDEX_DB_PATH=index/pedibot.db
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RETRIEVAL_MIN_SCORE=0.35           # umbral "fuente o silencio" (se calibra con el golden set)

# --- API ---
API_HOST=127.0.0.1
API_PORT=8601
ALLOWED_ORIGINS=https://pedibot.xyz
RATE_LIMIT_PER_10MIN=20
RATE_LIMIT_PER_DAY=200
OPS_DB_PATH=data/pedibot_ops.db

# --- Telegram (alertas al operador) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Redes (publish --social). Gratis: Bluesky + canal de Telegram. X solo si X_POST_ENABLED=true ---
BLUESKY_HANDLE=                    # p.ej. pedibot.bsky.social
BLUESKY_APP_PASSWORD=              # Bluesky → Settings → App passwords
TELEGRAM_CHANNEL=                  # @pedibot_news (el bot público debe ser admin del canal)
# --- X / Twitter (@pedibotai, API de pago por uso) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_POST_ENABLED=false

# --- Web ---
SITE_URL=https://pedibot.xyz

# --- Telegram público (el chatbot en Telegram; bot distinto del de alertas) ---
TELEGRAM_PUBLIC_BOT_TOKEN=
